<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);COFFEESHOP_API_ONLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CoffeeShop.Application\CoffeeShop.Application.csproj" />
    <ProjectReference Include="..\..\src\CoffeeShop.Contracts\CoffeeShop.Contracts.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\CoffeeShop.WinUI\ViewModels\*.cs" Link="ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\CoffeeShop.WinUI\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\CoffeeShop.WinUI\Security\ProtectedRefreshTokenFileStore.cs" Link="Services\ProtectedRefreshTokenFileStore.cs" />
    <Compile Include="..\..\src\CoffeeShop.WinUI\CoffeeShopClientConfiguration.cs" Link="Configuration\CoffeeShopClientConfiguration.cs" />
    <Compile Include="..\..\src\CoffeeShop.WinUI\Pages\IngredientRow.cs" Link="Presentation\IngredientRow.cs" />
    <Compile Include="..\..\src\CoffeeShop.WinUI\Pages\ReceiptLineRow.cs" Link="Presentation\ReceiptLineRow.cs" />
    <Compile Include="..\..\src\CoffeeShop.WinUI\Pages\SupplierRow.cs" Link="Presentation\SupplierRow.cs" />
    <Compile Include="..\CoffeeShop.Application.Tests\Testing\FakeCatalogRepository.cs" Link="Testing\FakeCatalogRepository.cs" />
    <Compile Include="..\CoffeeShop.Application.Tests\Testing\FakeInventoryRepository.cs" Link="Testing\FakeInventoryRepository.cs" />
    <Compile Include="..\CoffeeShop.Application.Tests\Testing\FakeCustomerRepository.cs" Link="Testing\FakeCustomerRepository.cs" />
    <Compile Include="..\CoffeeShop.Application.Tests\Testing\TestCurrentUser.cs" Link="Testing\TestCurrentUser.cs" />
    <Compile Include="..\CoffeeShop.Application.Tests\Testing\FakeUnitOfWork.cs" Link="Testing\FakeUnitOfWork.cs" />
    <Compile Include="..\CoffeeShop.Application.Tests\Testing\TestClock.cs" Link="Testing\TestClock.cs" />
    <Compile Include="..\CoffeeShop.Application.Tests\Testing\TestTransactionManager.cs" Link="Testing\TestTransactionManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="..\..\src\CoffeeShop.WinUI\LoginWindow.xaml" Link="Xaml\LoginWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\storage\unsplash-menu-photos.json" Link="Fixtures\unsplash-menu-photos.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CoffeeShop.WinUI\Pages\StockRoomPage.xaml" Link="Xaml\StockRoomPage.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CoffeeShop.WinUI\Theme\*.xaml" Link="Xaml\Theme\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
