# Copy to .env for local development; never commit real values.
POSTGRES_DB=coffeeshop
POSTGRES_USER=coffeeshop
POSTGRES_PASSWORD=replace-with-local-password
Jwt__Issuer=CoffeeShop.Local
Jwt__Audience=CoffeeShop.WinUI
Jwt__SigningKey=replace-with-a-long-random-local-key
# Optional administrator OAuth. Add the following keys to a private .env.google-admin file for Compose.
# GoogleAdmin__Enabled=true
# GoogleAdmin__ClientId=replace-with-desktop-client-id.apps.googleusercontent.com
# GoogleAdmin__ClientSecret=replace-with-desktop-client-secret
# GoogleAdmin__Links__0__UserId=replace-with-existing-administrator-id
# GoogleAdmin__Links__0__Subject=replace-with-verified-google-subject
# GoogleAdmin__Links__0__Email=replace-with-administrator-google-email
# Optional loopback ports for Docker Compose; change if the host ports are occupied.
API_PORT=5232
POSTGRES_PORT=5432
# Local S3-compatible photo storage (RustFS). Generate unique credentials in .env.
STORAGE_ACCESS_KEY=coffeeshop-local
STORAGE_SECRET_KEY=replace-with-local-storage-password
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Optional API build image overrides.
SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0
RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0

# Separate settings for non-Compose processes. Set them in those processes if needed.
# ConnectionStrings__CoffeeShop=Host=127.0.0.1;Port=5432;Database=coffeeshop;Username=coffeeshop_midterm;Password=replace-with-midterm-runtime-password

# Optional reporting assistant. Set the provider to openai and add your NVIDIA key in .env.
Assistant__Provider=none
Assistant__Endpoint=https://integrate.api.nvidia.com/v1/chat/completions
Assistant__Model=nvidia/nemotron-3.5-super-vl-120b-a12b
Assistant__ApiKey=
