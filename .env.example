# Copy to .env for local development; never commit real values.
POSTGRES_DB=coffeeshop
POSTGRES_USER=coffeeshop
POSTGRES_PASSWORD=replace-with-local-password
# WinUI runtime only; use a separate administrator connection for migrations/seeding.
ConnectionStrings__CoffeeShop=Host=127.0.0.1;Port=5432;Database=coffeeshop;Username=coffeeshop_midterm;Password=replace-with-local-password
Jwt__Issuer=CoffeeShop.Local
Jwt__Audience=CoffeeShop.WinUI
Jwt__SigningKey=replace-with-a-long-random-local-key
Ai__Provider=none
Ai__ApiKey=replace-only-if-ai-provider-is-enabled
