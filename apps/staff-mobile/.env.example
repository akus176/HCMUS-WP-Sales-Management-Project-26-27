# Public build configuration only. Copy to ignored .env.local and edit locally.
# Profiles: emulator, device, test, release. See docs/mobile-environment-139.md.
EXPO_PUBLIC_APP_ENV=emulator
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5232/api/v1

# Optional public menu-photo bucket, using the same image keys as Windows Counter.
# Emulator defaults to http://10.0.2.2:9000/menu-images/; other profiles use icons
# unless this is set to an HTTP(S) public bucket URL. Never put credentials here.
# EXPO_PUBLIC_MENU_PHOTOS_BASE_URL=https://assets.example/menu-images/
