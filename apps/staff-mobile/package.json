{
  "name": "@coffee-shop/staff-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "26.5.0",
    "npm": "11.17.0"
  },
  "dependencies": {
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "prettier": "3.9.10",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo run:android",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/starter.test.tsx",
    "test:components": "jest --runInBand tests/router.test.tsx",
    "test:e2e:android": "maestro test --format junit --output .maestro/results/junit.xml .maestro/starter.yaml",
    "check": "npm run type-check && npm run lint && npm run format:check && npm test"
  }
}
