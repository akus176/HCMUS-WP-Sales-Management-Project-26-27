{
  "name": "@coffee-shop/staff-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "26.5.0",
    "npm": "11.17.0"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.0",
    "@tanstack/react-query": "5.105.3",
    "expo": "58.0.23",
    "expo-application": "58.1.2",
    "expo-asset": "58.0.14",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.16",
    "expo-network": "58.0.4",
    "expo-notifications": "58.1.8",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "prettier": "3.9.10",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo run:android",
    "smoke:android": "expo export --platform android --output-dir dist/android-smoke",
    "check:android-health": "node --env-file-if-exists=.env.local scripts/check-android-health.mjs",
    "api:generate": "node ../../contracts/mobile-p0/node_modules/openapi-typescript/bin/cli.js ../../contracts/mobile-p0/openapi.json --output ../../contracts/mobile-p0/schema.d.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- ../../contracts/mobile-p0/schema.d.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:accessibility": "jest --runInBand tests/accessibility.test.tsx",
    "test:e2e:suite": "pwsh -NoProfile -File scripts/verify-android-suite.ps1",
    "test:inventory-harness": "node --test scripts/inventory-forwarder.test.mjs",
    "test:workflow-harness": "node --test scripts/workflow-forwarder.test.mjs",
    "test:e2e:workflows": "node --env-file-if-exists=.env.workflows.local scripts/verify-android-workflows.mjs",
    "test:unit": "jest --runInBand tests/session.test.ts tests/secure-storage.test.ts tests/environment.test.ts",
    "test:components": "jest --runInBand tests/router.test.tsx tests/login.test.tsx tests/navigation.test.tsx",
    "test:live": "jest --runInBand --testMatch **/tests/live-session.integration.ts",
    "pretest:e2e:android": "node -e \"require('node:fs').mkdirSync('.maestro/results', { recursive: true })\"",
    "test:e2e:android": "maestro test --format junit --output .maestro/results/junit.xml .maestro/starter.yaml",
    "pretest:e2e:session": "npm run pretest:e2e:android",
    "test:e2e:session": "maestro test --format junit --output .maestro/results/session.xml .maestro/session.yaml",
    "pretest:e2e:session-account": "npm run pretest:e2e:android",
    "test:e2e:session-account": "maestro test --format junit --output .maestro/results/session-account.xml .maestro/session-account",
    "pretest:e2e:barista": "npm run pretest:e2e:android",
    "test:e2e:barista": "maestro test --format junit --output .maestro/results/barista.xml .maestro/barista.yaml",
    "pretest:e2e:cashier": "npm run pretest:e2e:android",
    "test:e2e:cashier": "maestro test --format junit --output .maestro/results/cashier.xml .maestro/cashier.yaml",
    "pretest:e2e:manager-orders": "npm run pretest:e2e:android",
    "test:e2e:manager-orders": "maestro test --format junit --output .maestro/results/manager-orders.xml .maestro/manager-orders.yaml",
    "check": "npm run type-check && npm run lint && npm run format:check && npm test && npm run test:inventory-harness && npm run test:workflow-harness"
  }
}
