<Window
    x:Class="CoffeeShop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Coffee Shop — Menu, Customers and Inventory">
    <Grid Background="{StaticResource SketchBackgroundBrush}" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="DatabaseStatusBar"
                Grid.Row="0"
                Padding="16,10"
                Background="{StaticResource SketchMutedBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DatabaseStatusText"
                           VerticalAlignment="Center"
                           Text="Checking database connection..."
                           TextWrapping="Wrap" />
                <Button x:Name="RetryDatabaseButton"
                        Grid.Column="1"
                        Content="Retry"
                        Click="OnRetryDatabaseClick"
                        Visibility="Collapsed" />
            </Grid>
        </Border>
        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        IsEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Point of Sale" Tag="pos">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE719;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Fulfillment &amp; Operations" Tag="operations">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE768;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Menu and Recipes" Tag="catalog">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Customers and Loyalty" Tag="customers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Ingredients"
                        Tag="ingredients">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Suppliers"
                        Tag="suppliers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Purchase Receipts"
                        Tag="receipts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Low Stock"
                        Tag="lowstock">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Reports"
                        Tag="reports">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Stock Adjustments"
                        Tag="adjustments"
                        IsEnabled="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Movement History"
                        Tag="movements"
                        IsEnabled="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"
                    Background="Transparent"/>
        </NavigationView>
    </Grid>
</Window>
