<Window
    x:Class="CoffeeShop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Corner Cafe — Service Console">
    <Grid x:Name="ShellRoot"
          Background="{StaticResource SketchBackgroundBrush}"
          RequestedTheme="Light"
          SizeChanged="OnShellSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ShellStatusBar"
                Grid.Row="0"
                Padding="12,0"
                Background="{StaticResource SketchSurfaceBrush}"
                BorderBrush="{StaticResource SketchSoftBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{StaticResource SketchPostItBrush}"
                        BorderBrush="{StaticResource SketchBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <FontIcon Glyph="&#xE719;" FontSize="11" />
                </Border>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource SketchHeadingFontFamily}"
                           FontSize="15"
                           Text="Corner Cafe" />
                <TextBlock x:Name="ShellTitle"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SketchTertiaryForegroundBrush}"
                           FontFamily="{StaticResource SketchBodyFontFamily}"
                           FontSize="12"
                           CharacterSpacing="120"
                           Text="SERVICE CONSOLE" />
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite">
                    <Ellipse x:Name="ConnectionStatusDot"
                             Width="7"
                             Height="7"
                             Fill="{StaticResource SketchTertiaryForegroundBrush}" />
                    <TextBlock x:Name="ConnectionStatusText"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource SketchBodyFontFamily}"
                               FontSize="12"
                               Text="Checking connection" />
                    <TextBlock x:Name="ConnectionStatusDetail"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SketchTertiaryForegroundBrush}"
                               FontFamily="{StaticResource SketchNumericFontFamily}"
                               FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="DatabaseFailurePanel"
                Grid.Row="1"
                Style="{StaticResource ServiceConsoleWarningRowStyle}"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Assertive">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7BA;"
                          Foreground="{StaticResource SketchAccentBrush}"
                          AutomationProperties.Name="Connection warning" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="The service console is offline"
                               Style="{StaticResource ServiceConsoleSectionTitleStyle}"
                               FontSize="18" />
                    <TextBlock x:Name="DatabaseStatusText"
                               Text="Checking database connection..."
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="RetryDatabaseButton"
                        Grid.Column="2"
                        Content="Retry connection"
                        Style="{StaticResource ServiceConsoleSecondaryButtonStyle}"
                        Click="OnRetryDatabaseClick"
                        Visibility="Collapsed" />
            </Grid>
        </Border>

        <NavigationView x:Name="Nav"
                        Grid.Row="2"
                        IsEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        CompactPaneLength="58"
                        OpenPaneLength="226"
                        PaneDisplayMode="Left"
                        Background="{StaticResource SketchBackgroundBrush}"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.PaneHeader>
                <Grid Padding="8,12,8,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40"
                            Height="40"
                            Background="{StaticResource SketchPostItBrush}"
                            BorderBrush="{StaticResource SketchBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="20">
                        <FontIcon Glyph="&#xE719;"
                                  FontSize="20"
                                  AutomationProperties.Name="Corner Cafe" />
                    </Border>
                    <StackPanel x:Name="BrandCopy" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource SketchHeadingFontFamily}"
                                   FontSize="22"
                                   Text="Corner Cafe" />
                        <TextBlock Style="{StaticResource ServiceConsoleCaptionStyle}"
                                   CharacterSpacing="120"
                                   Text="SERVICE CONSOLE" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <Frame x:Name="ContentFrame"
                   Background="Transparent"
                   HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Stretch" />
        </NavigationView>
    </Grid>
</Window>
