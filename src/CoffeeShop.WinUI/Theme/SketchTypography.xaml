<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="SketchHeadingFontFamily">ms-appx:///Assets/Fonts/Kalam-Bold.ttf#Kalam</FontFamily>
    <FontFamily x:Key="SketchBodyFontFamily">ms-appx:///Assets/Fonts/PatrickHand-Regular.ttf#Patrick Hand</FontFamily>
    <FontFamily x:Key="SketchNumericFontFamily">Cascadia Mono, Consolas</FontFamily>

    <x:Double x:Key="SketchDisplayFontSize">40</x:Double>
    <x:Double x:Key="SketchTitleFontSize">32</x:Double>
    <x:Double x:Key="SketchSectionFontSize">24</x:Double>
    <x:Double x:Key="SketchBodyFontSize">16</x:Double>
    <x:Double x:Key="SketchCaptionFontSize">12</x:Double>
</ResourceDictionary>
