<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ServiceConsolePaperPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SketchSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SketchBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SketchRegularStroke}" />
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobbly}" />
        <Setter Property="Padding" Value="{StaticResource ServiceConsolePanelPadding}" />
    </Style>

    <Style x:Key="ServiceConsoleSelectedCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource ServiceConsolePaperPanelStyle}">
        <Setter Property="Background" Value="{StaticResource SketchSecondaryAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SketchSecondaryAccentBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SketchStrongStroke}" />
    </Style>

    <Style x:Key="ServiceConsoleWarningRowStyle"
           TargetType="Border"
           BasedOn="{StaticResource ServiceConsolePaperPanelStyle}">
        <Setter Property="Background" Value="{StaticResource SketchAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SketchAccentBrush}" />
        <Setter Property="BorderThickness" Value="3,1,1,1" />
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusSmall}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="ServiceConsoleTicketSurfaceStyle"
           TargetType="Border"
           BasedOn="{StaticResource ServiceConsolePaperPanelStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobblyMd}" />
        <Setter Property="BorderThickness" Value="{StaticResource SketchStrongStroke}" />
    </Style>

    <Style x:Key="ServiceConsoleFeatureCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource ServiceConsolePaperPanelStyle}">
        <Setter Property="Background" Value="{StaticResource SketchPostItBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SketchStrongStroke}" />
    </Style>

    <Style x:Key="ServiceConsolePillStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SketchSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SketchSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SketchThinStroke}" />
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusPill}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="ServiceConsoleStatusStampStyle"
           TargetType="Border"
           BasedOn="{StaticResource ServiceConsolePillStyle}">
        <Setter Property="Background" Value="{StaticResource SketchSuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SketchSuccessBrush}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="ServiceConsoleShadowStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SketchForegroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobbly}" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="3" Y="3" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
