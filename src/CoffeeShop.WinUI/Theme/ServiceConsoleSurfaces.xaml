<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ConsolePaperPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ConsoleGroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="ConsoleTicketStyle" TargetType="Border" BasedOn="{StaticResource ConsolePaperPanelStyle}">
        <Setter Property="Background" Value="{StaticResource ConsoleFieldBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleAccentBrush}" />
        <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>
    <Style x:Key="ConsoleStampStyle" TargetType="Border" BasedOn="{StaticResource ConsolePaperPanelStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleAccentBrush}" />
    </Style>
    <Style x:Key="ConsoleListRowStyle" TargetType="Border" BasedOn="{StaticResource ConsolePaperPanelStyle}">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style x:Key="ConsolePillStyle" TargetType="Border" BasedOn="{StaticResource ConsoleStampStyle}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="ConsoleSelectedRowStyle" TargetType="Border" BasedOn="{StaticResource ConsoleListRowStyle}">
        <Setter Property="Background" Value="{StaticResource ConsolePanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleAccentBrush}" />
        <Setter Property="BorderThickness" Value="2,0,0,1" />
    </Style>
    <Style x:Key="ConsoleWarningStyle" TargetType="Border" BasedOn="{StaticResource ConsoleSelectedRowStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>
</ResourceDictionary>
