<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WorkspaceButton" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="CharacterSpacing" Value="160" />
    </Style>
    <Style x:Key="WorkspacePrimary" TargetType="Button" BasedOn="{StaticResource ConsolePrimaryButtonStyle}">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="CharacterSpacing" Value="160" />
    </Style>
    <Style x:Key="WorkspaceLink" TargetType="Button" BasedOn="{StaticResource WorkspaceButton}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleAccentTextBrush}" />
    </Style>
    <Style x:Key="WorkspaceText" TargetType="TextBlock" BasedOn="{StaticResource ConsoleBodyStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WorkspaceHeading" TargetType="TextBlock" BasedOn="{StaticResource ConsoleSectionTitleStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WorkspaceLabel" TargetType="TextBlock" BasedOn="{StaticResource ConsoleLabelStyle}">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WorkspaceTab" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleTabStyle}">
        <Setter Property="Padding" Value="0,0,16,0" />
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Grid Background="Transparent" Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Label.Opacity" Value=".7" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Pressed" />
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Label.Opacity" Value=".4" /></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="CheckStates">
                            <VisualState x:Name="Unchecked" />
                            <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Rule.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" CharacterSpacing="{TemplateBinding CharacterSpacing}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                    <Border x:Name="Rule" Visibility="Collapsed" Height="1" Background="{StaticResource ConsoleAccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                </Grid>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WorkspaceListItem" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
    </Style>
    <Style x:Key="WorkspacePanel" TargetType="Border" BasedOn="{StaticResource ConsolePaperPanelStyle}">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12,0,12" />
    </Style>
    <Style x:Key="WorkspaceDialog" TargetType="ContentDialog">
        <Setter Property="RequestedTheme" Value="Light" />
        <Setter Property="Background" Value="{StaticResource ConsoleGroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource WorkspacePrimary}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource WorkspaceButton}" />
    </Style>
    <Style x:Key="WorkspaceDrinkDialog" TargetType="ContentDialog" BasedOn="{StaticResource WorkspaceDialog}">
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ContentDialog">
                <Grid x:Name="Container">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="DialogShowingStates">
                            <VisualState x:Name="DialogHidden"/>
                            <VisualState x:Name="DialogShowing"><VisualState.Setters>
                                <Setter Target="LayoutRoot.Visibility" Value="Visible"/>
                                <Setter Target="BackgroundElement.TabFocusNavigation" Value="Cycle"/>
                            </VisualState.Setters></VisualState>
                            <VisualState x:Name="DialogShowingWithoutSmokeLayer"><VisualState.Setters><Setter Target="LayoutRoot.Visibility" Value="Visible"/></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="DialogSizingStates"><VisualState x:Name="DefaultDialogSizing"/><VisualState x:Name="FullDialogSizing"/></VisualStateGroup>
                        <VisualStateGroup x:Name="ButtonsVisibilityStates"><VisualState x:Name="PrimaryAndCloseVisible"/></VisualStateGroup>
                        <VisualStateGroup x:Name="DefaultButtonStates"><VisualState x:Name="NoDefaultButton"/><VisualState x:Name="PrimaryAsDefaultButton"/></VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid x:Name="LayoutRoot" Visibility="Collapsed">
                        <Rectangle x:Name="SmokeLayerBackground" Fill="#9E262321"/>
                        <Border x:Name="BackgroundElement" MaxWidth="760" Margin="24" VerticalAlignment="Center" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,2,0,0" Padding="26,22,26,20">
                            <Grid RowSpacing="16">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Spacing="4" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                    <TextBlock Text="MENU / DRINK DETAILS" Style="{StaticResource WorkspaceLabel}"/>
                                    <ContentPresenter x:Name="Title" Content="{TemplateBinding Title}" ContentTemplate="{TemplateBinding TitleTemplate}"/>
                                </StackPanel>
                                <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" MaxHeight="520" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
                                    <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                </ScrollViewer>
                                <Grid x:Name="CommandSpace" Grid.Row="2" ColumnSpacing="10" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button x:Name="CloseButton" Content="{TemplateBinding CloseButtonText}" Style="{TemplateBinding CloseButtonStyle}"/>
                                    <Button x:Name="PrimaryButton" Grid.Column="2" Content="{TemplateBinding PrimaryButtonText}" IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}" Style="{TemplateBinding PrimaryButtonStyle}"/>
                                    <Button x:Name="SecondaryButton" Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
