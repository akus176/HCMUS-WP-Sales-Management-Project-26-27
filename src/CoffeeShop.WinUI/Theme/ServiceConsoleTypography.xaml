<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="ConsoleSerifFont">ms-appx:///Assets/Fonts/EBGaramond-Regular.ttf#EB Garamond</FontFamily>
    <FontFamily x:Key="ConsoleSansFont">ms-appx:///Assets/Fonts/InstrumentSans-Regular.ttf#Instrument Sans</FontFamily>
    <FontFamily x:Key="ConsoleSansMediumFont">ms-appx:///Assets/Fonts/InstrumentSans-Medium.ttf#Instrument Sans Medium</FontFamily>
    <Style x:Key="ConsoleWordmarkStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSansMediumFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ConsolePageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSerifFont}" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="CharacterSpacing" Value="-15" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleInkBrush}" />
    </Style>
    <Style x:Key="ConsoleSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSerifFont}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleInkBrush}" />
    </Style>
    <Style x:Key="ConsoleLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleMutedInkBrush}" />
    </Style>
    <Style x:Key="ConsoleBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleMutedInkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ConsoleNumberStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSerifFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Typography.NumeralStyle" Value="Lining" />
    </Style>
    <Style x:Key="ConsoleValidationStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleDangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
