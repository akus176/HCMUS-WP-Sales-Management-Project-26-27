<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SketchBackgroundColor">#FBF7EE</Color>
    <Color x:Key="SketchSurfaceColor">#FFFDF7</Color>
    <Color x:Key="SketchMutedColor">#F1E9DB</Color>
    <Color x:Key="SketchMutedStrongColor">#E9DFCF</Color>
    <Color x:Key="SketchForegroundColor">#241F1A</Color>
    <Color x:Key="SketchSecondaryForegroundColor">#5A5147</Color>
    <Color x:Key="SketchTertiaryForegroundColor">#8B8174</Color>
    <Color x:Key="SketchLineColor">#2B2621</Color>
    <Color x:Key="SketchSoftLineColor">#D9CFBF</Color>
    <Color x:Key="SketchAccentColor">#BC3B32</Color>
    <Color x:Key="SketchSecondaryAccentColor">#2D5DA1</Color>
    <Color x:Key="SketchSuccessColor">#2F6B4F</Color>
    <Color x:Key="SketchPostItColor">#FFE077</Color>
    <Color x:Key="SketchPostItSoftColor">#FFF3BD</Color>
    <Color x:Key="SketchAccentSoftColor">#F8E2DD</Color>
    <Color x:Key="SketchSecondaryAccentSoftColor">#E5EDF8</Color>
    <Color x:Key="SketchSuccessSoftColor">#E7EFE9</Color>

    <SolidColorBrush x:Key="SketchBackgroundBrush" Color="{StaticResource SketchBackgroundColor}" />
    <SolidColorBrush x:Key="SketchSurfaceBrush" Color="{StaticResource SketchSurfaceColor}" />
    <SolidColorBrush x:Key="SketchForegroundBrush" Color="{StaticResource SketchForegroundColor}" />
    <SolidColorBrush x:Key="SketchSecondaryForegroundBrush" Color="{StaticResource SketchSecondaryForegroundColor}" />
    <SolidColorBrush x:Key="SketchTertiaryForegroundBrush" Color="{StaticResource SketchTertiaryForegroundColor}" />
    <SolidColorBrush x:Key="SketchMutedBrush" Color="{StaticResource SketchMutedColor}" />
    <SolidColorBrush x:Key="SketchMutedStrongBrush" Color="{StaticResource SketchMutedStrongColor}" />
    <SolidColorBrush x:Key="SketchBorderBrush" Color="{StaticResource SketchLineColor}" />
    <SolidColorBrush x:Key="SketchSoftBorderBrush" Color="{StaticResource SketchSoftLineColor}" />
    <SolidColorBrush x:Key="SketchAccentBrush" Color="{StaticResource SketchAccentColor}" />
    <SolidColorBrush x:Key="SketchAccentSoftBrush" Color="{StaticResource SketchAccentSoftColor}" />
    <SolidColorBrush x:Key="SketchSecondaryAccentBrush" Color="{StaticResource SketchSecondaryAccentColor}" />
    <SolidColorBrush x:Key="SketchSecondaryAccentSoftBrush" Color="{StaticResource SketchSecondaryAccentSoftColor}" />
    <SolidColorBrush x:Key="SketchSuccessBrush" Color="{StaticResource SketchSuccessColor}" />
    <SolidColorBrush x:Key="SketchSuccessSoftBrush" Color="{StaticResource SketchSuccessSoftColor}" />
    <SolidColorBrush x:Key="SketchPostItBrush" Color="{StaticResource SketchPostItColor}" />
    <SolidColorBrush x:Key="SketchPostItSoftBrush" Color="{StaticResource SketchPostItSoftColor}" />

    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{StaticResource SketchSecondaryAccentColor}" />
    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{StaticResource SketchSurfaceColor}" />
</ResourceDictionary>
