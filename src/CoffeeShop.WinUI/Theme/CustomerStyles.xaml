<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SketchCustomerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ServiceConsoleSecondaryButtonStyle}" />
    <Style x:Key="SketchCustomerFieldStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource ServiceConsoleTextBoxStyle}" />
    <Style x:Key="SketchCustomerCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource ServiceConsolePaperPanelStyle}" />
    <Style x:Key="SketchCustomerHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SketchHeadingFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource SketchSectionFontSize}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
