<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SketchCustomerButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}"/>
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobbly}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{StaticResource SketchBorderBrush}"/>
    </Style>
    <Style x:Key="SketchCustomerFieldStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}"/>
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobbly}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{StaticResource SketchBorderBrush}"/>
    </Style>
    <Style x:Key="SketchCustomerCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SketchBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SketchBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobblyMd}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="SketchCustomerHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SketchHeadingFontFamily}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
