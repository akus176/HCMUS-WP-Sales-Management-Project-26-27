<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ConsoleButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource ConsoleTouchTarget}" />
        <Setter Property="MinHeight" Value="{StaticResource ConsoleTouchTarget}" />
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleInkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleInkBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource ConsoleGroundBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Chrome.Background" Value="{StaticResource ConsolePanelBrush}" /><Setter Target="Label.Foreground" Value="{StaticResource ConsoleInkBrush}" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Chrome.Background" Value="{StaticResource ConsolePanelBrush}" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Chrome.Opacity" Value=".4" /></VisualState.Setters></VisualState>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" CharacterSpacing="{TemplateBinding CharacterSpacing}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ConsolePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ConsoleFieldBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleOnFieldBrush}" />
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Chrome.Background" Value="{StaticResource ConsoleFieldDeepBrush}" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Chrome.Opacity" Value=".85" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Chrome.Opacity" Value=".4" /></VisualState.Setters></VisualState>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" CharacterSpacing="{TemplateBinding CharacterSpacing}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ConsoleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="ConsoleFieldStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleRuleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
    </Style>
    <Style x:Key="ConsoleTabStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleAccentBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
    </Style>
    <Style x:Key="ConsoleNavigationItemStyle" TargetType="NavigationViewItem">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="18,0,18,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    </Style>
    <Style x:Key="ConsoleNavigationGroupStyle" TargetType="NavigationViewItemHeader">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
        <Setter Property="FontSize" Value="7" />
        <Setter Property="CharacterSpacing" Value="200" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="19" />
        <Setter Property="Margin" Value="18,20,18,3" />
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="NavigationViewItemHeader">
                <Border BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,5">
                    <ContentPresenter Content="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" CharacterSpacing="{TemplateBinding CharacterSpacing}" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                </Border>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
