<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ServiceConsolePrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ServiceConsoleTouchTarget}" />
        <Setter Property="Padding" Value="{StaticResource ServiceConsoleControlPadding}" />
        <Setter Property="Background" Value="{StaticResource SketchSecondaryAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SketchSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SketchBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SketchStrongStroke}" />
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobbly}" />
        <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SketchBodyFontSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="ServiceConsoleSecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ServiceConsoleTouchTarget}" />
        <Setter Property="Padding" Value="{StaticResource ServiceConsoleControlPadding}" />
        <Setter Property="Background" Value="{StaticResource SketchSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SketchForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SketchBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SketchStrongStroke}" />
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobblyAlt}" />
        <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SketchBodyFontSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="ServiceConsoleDangerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ServiceConsoleSecondaryButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource SketchAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SketchAccentBrush}" />
    </Style>

    <Style x:Key="ServiceConsoleIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ServiceConsoleSecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource ServiceConsoleTouchTarget}" />
        <Setter Property="Width" Value="{StaticResource ServiceConsoleTouchTarget}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="ServiceConsoleTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource ServiceConsoleTouchTarget}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{StaticResource SketchSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SketchForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SketchBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SketchRegularStroke}" />
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SketchBodyFontSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="ServiceConsoleComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource ServiceConsoleTouchTarget}" />
        <Setter Property="Background" Value="{StaticResource SketchSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SketchForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SketchBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SketchRegularStroke}" />
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SketchBodyFontSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="ServiceConsoleTabStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{StaticResource ServiceConsoleTouchTarget}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SketchSecondaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SketchSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SketchBodyFontSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="ServiceConsoleNavigationItemStyle" TargetType="NavigationViewItem">
        <Setter Property="MinHeight" Value="{StaticResource ServiceConsoleTouchTarget}" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SketchBodyFontSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="ServiceConsoleListRowStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource ServiceConsoleTouchTarget}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusSmall}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="ServiceConsolePageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SketchHeadingFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SketchDisplayFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource SketchForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ServiceConsoleSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SketchHeadingFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SketchSectionFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource SketchForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ServiceConsoleCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SketchCaptionFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource SketchTertiaryForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
