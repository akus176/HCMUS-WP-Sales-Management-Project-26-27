<Window
    x:Class="CoffeeShop.WinUI.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Corner Cafe · Sign in">
    <Grid x:Name="LoginRoot"
          Background="{StaticResource ConsoleGroundBrush}"
          RequestedTheme="Light"
          Loaded="OnLoaded">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <StaticResource x:Key="SignInGroundBrush" ResourceKey="ConsoleGroundBrush" />
                        <StaticResource x:Key="SignInInkBrush" ResourceKey="ConsoleInkBrush" />
                        <StaticResource x:Key="SignInMutedBrush" ResourceKey="ConsoleMutedInkBrush" />
                        <StaticResource x:Key="SignInRuleBrush" ResourceKey="ConsoleRuleBrush" />
                        <StaticResource x:Key="SignInAccentBrush" ResourceKey="ConsoleAccentTextBrush" />
                        <SolidColorBrush x:Key="SignInErrorBrush" Color="#9A3D32" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ConsoleFieldDeepBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ConsoleAccentTextBrush" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="ConsoleOnFieldBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="ConsoleOnFieldBrush" />
                        <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ConsoleAccentTextBrush" />
                        <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ConsoleGroundBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="SignInGroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="SignInInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="SignInMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="SignInRuleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="SignInAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="SignInErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style x:Key="SignInField" TargetType="TextBox" BasedOn="{StaticResource ConsoleFieldStyle}">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="MinHeight" Value="52" />
                    <Setter Property="Padding" Value="12,14" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Background" Value="{ThemeResource SignInGroundBrush}" />
                    <Setter Property="Foreground" Value="{ThemeResource SignInInkBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource SignInRuleBrush}" />
                    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SignInAccentBrush}" />
                </Style>
                <Style x:Key="SignInError" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Foreground" Value="{ThemeResource SignInErrorBrush}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid Background="{ThemeResource SignInGroundBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          MaxWidth="516" Padding="24"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          IsTabStop="False">
                <StackPanel Spacing="24" VerticalAlignment="Center">
                    <TextBlock Text="Corner Cafe" FontFamily="{StaticResource ConsoleSansMediumFont}" FontSize="20" Foreground="{ThemeResource SignInInkBrush}" />
                    <Border BorderBrush="{ThemeResource SignInRuleBrush}" BorderThickness="0,1,0,0" Padding="0,24,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Staff sign in" FontFamily="{StaticResource ConsoleSansMediumFont}" FontSize="32" TextWrapping="Wrap" Foreground="{ThemeResource SignInInkBrush}" AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock Text="Use your staff account to continue." FontFamily="{StaticResource ConsoleSansFont}" FontSize="15" TextWrapping="Wrap" Foreground="{ThemeResource SignInMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBox x:Name="UsernameBox" Header="Username" Style="{StaticResource SignInField}"
                                     IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                     AutomationProperties.Name="Username" AccessKey="U"
                                     KeyDown="OnCredentialsKeyDown" TextChanged="OnUsernameChanged" />
                            <TextBlock x:Name="UsernameError" Text="Enter your username." Style="{StaticResource SignInError}" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <PasswordBox x:Name="PasswordBox" Header="Password" FontFamily="{StaticResource ConsoleSansFont}" FontSize="16"
                                         MinHeight="52" Padding="12,14" CornerRadius="0" BorderThickness="1"
                                         Background="{ThemeResource SignInGroundBrush}" Foreground="{ThemeResource SignInInkBrush}"
                                         BorderBrush="{ThemeResource SignInRuleBrush}" FocusVisualPrimaryBrush="{ThemeResource SignInAccentBrush}"
                                         PasswordRevealMode="Peek" AutomationProperties.Name="Password" AccessKey="P"
                                         KeyDown="OnCredentialsKeyDown" PasswordChanged="OnPasswordChanged" />
                            <TextBlock x:Name="PasswordError" Text="Enter your password." Style="{StaticResource SignInError}" Visibility="Collapsed" />
                        </StackPanel>
                        <InfoBar x:Name="SignInFeedback" IsOpen="False" IsClosable="False" Severity="Error"
                                 FontFamily="{StaticResource ConsoleSansFont}" FontSize="14" CornerRadius="0"
                                 AutomationProperties.LiveSetting="Assertive" />
                        <Button x:Name="SignInButton" Content="Sign in" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                FontFamily="{StaticResource ConsoleSansMediumFont}" FontSize="16" MinHeight="52" Padding="16,14"
                                Background="{ThemeResource SignInInkBrush}" Foreground="{ThemeResource SignInGroundBrush}"
                                BorderBrush="{ThemeResource SignInInkBrush}" CornerRadius="0" AccessKey="S"
                                UseSystemFocusVisuals="True" FocusVisualPrimaryBrush="{ThemeResource SignInAccentBrush}"
                                Click="OnSignIn" />
                        <Grid MinHeight="24" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ProgressRing x:Name="SigningInProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed"
                                          Foreground="{ThemeResource SignInAccentBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="SigningInStatus" Grid.Column="1" FontFamily="{StaticResource ConsoleSansFont}" FontSize="14"
                                       Foreground="{ThemeResource SignInMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="Need an account or help signing in? Contact your manager."
                               FontFamily="{StaticResource ConsoleSansFont}" FontSize="14" TextWrapping="Wrap"
                               Foreground="{ThemeResource SignInMutedBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
