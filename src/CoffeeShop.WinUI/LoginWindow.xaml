<Window
    x:Class="CoffeeShop.WinUI.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Corner Cafe · Sign in">
    <Grid Background="#F3EEE4" Padding="36">
        <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
            <TextBlock Text="Corner Cafe" FontSize="30" FontFamily="Georgia" />
            <TextBlock Text="STAFF SIGN IN" FontSize="11" CharacterSpacing="180" Foreground="#6B6257" />
            <TextBox x:Name="UsernameBox" Header="Username" AutomationProperties.Name="Username" />
            <PasswordBox x:Name="PasswordBox" Header="Password" AutomationProperties.Name="Password" />
            <TextBlock x:Name="ErrorText" Foreground="#9A3D32" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
            <Button x:Name="SignInButton" Content="SIGN IN" HorizontalAlignment="Stretch" Click="OnSignIn" />
        </StackPanel>
    </Grid>
</Window>
