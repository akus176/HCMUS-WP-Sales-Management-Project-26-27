<Application
    x:Class="CoffeeShop.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Theme/ServiceConsoleColors.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/ServiceConsoleTypography.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/ServiceConsoleGeometry.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/ServiceConsoleControls.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/ServiceConsoleSurfaces.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/SketchColors.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/SketchTypography.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/SketchShapes.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/CustomerStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
