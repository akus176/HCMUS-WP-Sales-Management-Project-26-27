<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:CoffeeShop.WinUI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoffeeShop.WinUI.Pages.ReportsPage" FontFamily="{StaticResource ConsoleSansFont}" Foreground="{StaticResource ConsoleInkBrush}" Background="{StaticResource ConsoleGroundBrush}" RequestedTheme="Light">
    <Page.Resources>
        <SolidColorBrush x:Key="AssistantSurfaceBrush" Color="#FFFCF7" />
        <SolidColorBrush x:Key="AssistantFrameBrush" Color="#8A7148" />
        <SolidColorBrush x:Key="AssistantComposerBrush" Color="#F7F0E5" />
        <Style x:Key="ReportText" TargetType="TextBlock" BasedOn="{StaticResource ConsoleBodyStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ReportLabel" TargetType="TextBlock" BasedOn="{StaticResource ConsoleLabelStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="60" />
        </Style>
        <Style x:Key="ReportHeading" TargetType="TextBlock" BasedOn="{StaticResource ConsoleSectionTitleStyle}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ReportButton" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CharacterSpacing" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="ReportPrimary" TargetType="Button" BasedOn="{StaticResource ConsolePrimaryButtonStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CharacterSpacing" Value="0" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="ReportLink" TargetType="Button" BasedOn="{StaticResource ReportButton}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleAccentTextBrush}" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="AssistantHeaderButton" TargetType="Button" BasedOn="{StaticResource ReportPrimary}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleAccentLightBrush}" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentLightBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource ConsoleFieldBrush}" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="ReportPanel" TargetType="Border" BasedOn="{StaticResource WorkspacePanel}">
            <Setter Property="Padding" Value="0,12,0,16" />
        </Style>
        <Style x:Key="RevenueSegmentGroup" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ConsoleRaisedGroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConsoleRuleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style x:Key="RevenueSegment" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontFamily" Value="{StaticResource ConsoleSansMediumFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource ConsoleGroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Opacity" Value=".75" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Opacity" Value=".6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Segment.Background" Value="{StaticResource ConsoleFieldBrush}" />
                                            <Setter Target="Label.Foreground" Value="{StaticResource ConsoleOnFieldBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                                              Foreground="{StaticResource ConsoleInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AssistantPromptButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ConsoleGroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConsolePanelLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleInkBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="ReportListItem" TargetType="ListViewItem" BasedOn="{StaticResource WorkspaceListItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource ReportText}" />
        <Style TargetType="Button" BasedOn="{StaticResource ReportButton}" />
        <Style TargetType="ListViewItem" BasedOn="{StaticResource ReportListItem}" />
        <Style x:Key="ReportFlyout" TargetType="FlyoutPresenter">
            <Setter Property="RequestedTheme" Value="Light" />
            <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
            <Setter Property="Background" Value="{StaticResource ConsoleGroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConsoleRuleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>
    <Grid Padding="{StaticResource ConsolePagePadding}" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="Header" SizeChanged="OnReportsHeaderSizeChanged" GettingFocus="OnReportsGettingFocus" Padding="0,0,0,10" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1" ColumnSpacing="18" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Reports" Style="{StaticResource ConsolePageTitleStyle}" x:Name="ReportsTitle" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="PeriodLabel" Style="{StaticResource ReportLabel}" />
            </StackPanel>
            <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Button x:Name="PeriodButton" Content="Reporting period" AutomationProperties.Name="Choose reporting period">
                    <Button.Flyout>
                        <Flyout x:Name="PeriodFlyout" FlyoutPresenterStyle="{StaticResource ReportFlyout}" Opened="OnPeriodOpened">
                            <StackPanel Spacing="12" MinWidth="280" MaxWidth="360">
                                <TextBlock Text="Reporting period" Style="{StaticResource ReportHeading}" />
                                <TextBlock Text="Both dates are included. Reports use local time." FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                <DatePicker x:Name="FirstDate" Header="From" FontSize="14" MinHeight="44" HorizontalAlignment="Stretch" />
                                <DatePicker x:Name="LastDate" Header="To" FontSize="14" MinHeight="44" HorizontalAlignment="Stretch" />
                                <InfoBar x:Name="PeriodError" IsOpen="False" IsClosable="False" Severity="Error" />
                                <Button Content="Apply period" Click="OnApplyPeriod" Style="{StaticResource ReportPrimary}" x:Name="ApplyPeriodButton" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefresh" Style="{StaticResource ReportPrimary}" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="4">
            <ProgressBar x:Name="LoadingIndicator" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Loading reports" />
            <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" x:Name="ReportScroll" GettingFocus="OnReportsGettingFocus">
            <StackPanel Spacing="12" Margin="0,0,24,0">
                <Grid x:Name="Kpis" ColumnSpacing="1" RowSpacing="1" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="RevenueKpi" Background="{StaticResource ConsoleFieldBrush}" Padding="16,10" MinHeight="96">
                        <StackPanel Spacing="2">
                            <TextBlock Text="NET REVENUE" Style="{StaticResource ReportLabel}" Foreground="{StaticResource ConsoleOnFieldMutedBrush}" />
                            <TextBlock x:Name="RevenueTotal" Text="—" Style="{StaticResource ConsoleNumberStyle}" FontSize="36" Foreground="{StaticResource ConsoleOnFieldBrush}" />
                            <TextBlock Text="Recognized payments in period" Foreground="{StaticResource ConsoleOnFieldMutedBrush}" FontSize="12" LineHeight="18" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="OrdersKpi" Grid.Column="1" Padding="16,10" MinHeight="96">
                        <StackPanel Spacing="2">
                            <TextBlock Text="RECOGNIZED ORDERS" Style="{StaticResource ReportLabel}" />
                            <TextBlock x:Name="RevenueOrderCount" Text="—" Style="{StaticResource ConsoleNumberStyle}" FontSize="36" />
                            <TextBlock Text="Distinct orders in period" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" LineHeight="18" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="AverageKpi" Grid.Column="2" Padding="16,10" MinHeight="96">
                        <StackPanel Spacing="2">
                            <TextBlock Text="REVENUE PER ORDER" Style="{StaticResource ReportLabel}" />
                            <TextBlock x:Name="AverageTicket" Text="—" Style="{StaticResource ConsoleNumberStyle}" FontSize="36" />
                            <TextBlock Text="Recognized revenue / order count" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" LineHeight="18" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="StockKpi" Grid.Column="3" Padding="16,10" MinHeight="96" Background="{StaticResource ConsoleRaisedGroundBrush}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="LOW STOCK" Style="{StaticResource ReportLabel}" />
                            <TextBlock x:Name="StockCount" Text="—" Style="{StaticResource ConsoleNumberStyle}" FontSize="36" Foreground="{StaticResource ConsoleAccentTextBrush}" />
                            <TextBlock Text="Current balances · independent of period" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" LineHeight="18" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid x:Name="Dashboard" ColumnSpacing="24" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="1.15*" />
                        <ColumnDefinition x:Name="RightColumn" Width=".85*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="RevenuePanel" Style="{StaticResource ReportPanel}">
                        <StackPanel Spacing="3">
                            <Grid x:Name="RevenueHeader" ColumnSpacing="12" SizeChanged="OnRevenueHeaderSizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Revenue" Style="{StaticResource ReportHeading}" AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock Text="By payment date" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}"
                                               ToolTipService.ToolTip="Cancelled orders and orders with restored inventory are excluded."
                                               AutomationProperties.HelpText="Cancelled orders and orders with restored inventory are excluded." />
                                </StackPanel>
                                <Grid x:Name="RevenueControls" Grid.Column="1" ColumnSpacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource RevenueSegmentGroup}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RevenueDayOption" Content="Day" GroupName="RevenueGrouping" Style="{StaticResource RevenueSegment}" IsChecked="True" Checked="OnRevenueViewChanged" AutomationProperties.Name="Group revenue by day" />
                                            <RadioButton x:Name="RevenueMonthOption" Content="Month" GroupName="RevenueGrouping" Style="{StaticResource RevenueSegment}" Checked="OnRevenueViewChanged" AutomationProperties.Name="Group revenue by month" />
                                            <RadioButton x:Name="RevenueYearOption" Content="Year" GroupName="RevenueGrouping" Style="{StaticResource RevenueSegment}" Checked="OnRevenueViewChanged" AutomationProperties.Name="Group revenue by year" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="RevenueViewSegments" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource RevenueSegmentGroup}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RevenueChartOption" Content="Chart" GroupName="RevenueDisplay" Style="{StaticResource RevenueSegment}" IsChecked="True" Checked="OnRevenueViewChanged" AutomationProperties.Name="Show revenue chart" />
                                            <RadioButton x:Name="RevenueTableOption" Content="Table" GroupName="RevenueDisplay" Style="{StaticResource RevenueSegment}" Checked="OnRevenueViewChanged" AutomationProperties.Name="Show revenue table" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="RevenueEmpty" Visibility="Collapsed" Text="No recognized revenue in this period. Choose another period or complete a paid order." />
                            <TextBlock x:Name="RevenueError" Visibility="Collapsed" Foreground="{StaticResource ConsoleAccentTextBrush}" />
                            <Grid x:Name="RevenueGraph" Visibility="Collapsed" ColumnSpacing="10" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="RevenueAxis" Height="200" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
                                <ScrollViewer x:Name="RevenueChartScroll" Grid.Column="1" Height="220" Padding="0,0,0,16" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" SizeChanged="OnChartSizeChanged">
                                    <Grid x:Name="RevenueChart" Height="200" VerticalAlignment="Top" />
                                </ScrollViewer>
                            </Grid>
                            <TextBlock x:Name="RevenueChartHint" Visibility="Collapsed" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                            <StackPanel x:Name="RevenueTable" Visibility="Collapsed">
                                <Grid ColumnSpacing="12" Padding="0,8,20,8" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Period" Style="{StaticResource ReportLabel}" />
                                    <TextBlock Grid.Column="1" Text="Revenue" Style="{StaticResource ReportLabel}" TextAlignment="Right" />
                                </Grid>
                                <ListView x:Name="RevenuePeriodsList" SelectionMode="None" MaxHeight="320" AutomationProperties.Name="Revenue by period" Padding="0,0,20,0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,8" ColumnSpacing="12" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TableLabel}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding RevenueDisplay}" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <Border x:Name="RevenueSummaryPanel" Visibility="Collapsed" Padding="0,8,0,0" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0">
                                <TextBlock x:Name="RevenueSummary" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border x:Name="BestPanel" Grid.Column="1" Style="{StaticResource ReportPanel}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Best sellers" Style="{StaticResource ReportHeading}" />
                            <TextBlock Text="Quantity by completion date · revenue by payment date." FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                            <TextBlock x:Name="BestSellersEmpty" Visibility="Collapsed" Text="No completed items in this period. Choose another period or complete an order." />
                            <TextBlock x:Name="BestSellersError" Visibility="Collapsed" Foreground="{StaticResource ConsoleAccentTextBrush}" />
                            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled" Padding="0,0,24,0">
                                <ItemsControl x:Name="BestSellersList" IsTabStop="False" AutomationProperties.Name="Best sellers by quantity">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="48" ColumnSpacing="8" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Rank}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="17" Foreground="{StaticResource ConsoleAccentTextBrush}" VerticalAlignment="Center" />
                                                <Grid Grid.Column="1" RowSpacing="2" Padding="0,5,0,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="3" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding NameDisplay}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="18" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding NameDisplay}" />
                                                    <ProgressBar Grid.Row="1" Value="{Binding Quantity}" Maximum="{Binding Maximum}" Foreground="{StaticResource ConsoleAccentBrush}" Background="{StaticResource ConsoleRuleBrush}" MinHeight="3" Height="3" IsTabStop="False" />
                                                </Grid>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding QuantityDisplay}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="16" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding QuantityDisplay}" />
                                                    <TextBlock Text="{Binding RevenueDisplay}" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ChannelPanel" Grid.Row="1" Style="{StaticResource ReportPanel}">
                        <StackPanel Spacing="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="How they paid" Style="{StaticResource ReportHeading}" />
                                    <TextBlock Text="Recognized payments and orders in this period." FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Filters" Style="{StaticResource ReportLink}" x:Name="FiltersButton">
                                    <Button.Flyout>
                                        <Flyout FlyoutPresenterStyle="{StaticResource ReportFlyout}" x:Name="FiltersFlyout">
                                            <StackPanel Spacing="12" MinWidth="280" MaxWidth="320">
                                                <TextBlock Text="Breakdown filters" Style="{StaticResource ReportHeading}" />
                                                <ComboBox x:Name="PaymentFilter" Header="Payment method" MinHeight="44" HorizontalAlignment="Stretch" SelectionChanged="OnPaymentFilterChanged" FontSize="14">
                                                    <ComboBoxItem Content="All payment methods" Tag="" IsSelected="True" />
                                                    <ComboBoxItem Content="Cash" Tag="cash" />
                                                    <ComboBoxItem Content="Card" Tag="card" />
                                                    <ComboBoxItem Content="E-wallet" Tag="e_wallet" />
                                                </ComboBox>
                                                <ComboBox x:Name="ChannelFilter" Header="Order channel" MinHeight="44" HorizontalAlignment="Stretch" SelectionChanged="OnChannelFilterChanged" FontSize="14">
                                                    <ComboBoxItem Content="All channels" Tag="" IsSelected="True" />
                                                    <ComboBoxItem Content="Dine-in" Tag="dine_in" />
                                                    <ComboBoxItem Content="Takeaway" Tag="takeaway" />
                                                    <ComboBoxItem Content="Delivery" Tag="delivery" />
                                                </ComboBox>
                                                <TextBlock Text="These filters affect the payment and channel breakdowns. Summary cards show the full reporting period." FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" />
                                                <Button x:Name="ResetFiltersButton" Content="Reset filters" Click="OnResetFilters" Style="{StaticResource ReportButton}" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="FilterSummary" FontSize="12" Foreground="{StaticResource ConsoleAccentTextBrush}" />
                            <TextBlock x:Name="ChannelsEmpty" Visibility="Collapsed" Text="No recognized orders in this channel. Change the period or channel filter." />
                            <TextBlock x:Name="ChannelsError" Visibility="Collapsed" Foreground="{StaticResource ConsoleAccentTextBrush}" />
                            <TextBlock x:Name="PaymentsEmpty" Visibility="Collapsed" Text="No recognized payments for this filter." />
                            <Grid ColumnSpacing="12" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="PaymentDonut" Width="120" Height="120">
                                    <Canvas x:Name="PaymentArcs" Width="120" Height="120" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PaymentOrderCount" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="30" HorizontalAlignment="Center" />
                                        <TextBlock Text="ORDERS" Style="{StaticResource ReportLabel}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl x:Name="RevenuePaymentsList" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Revenue by payment method">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="38" ColumnSpacing="10" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="52" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="6" Height="6" Background="{Binding Color}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding RevenueDisplay}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="20" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Percentage}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Grid x:Name="ChannelsGrid" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" />
                            <TextBlock Text="Split-payment counts can occur in more than one payment bucket." FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="StockPanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource ReportPanel}" Background="{StaticResource ConsoleRaisedGroundBrush}" Padding="16,12" BorderThickness="0,2,0,0" BorderBrush="{StaticResource ConsoleAccentBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Fix before close" Style="{StaticResource ReportHeading}" />
                            <TextBlock Text="Current active ingredients at or below their reorder threshold." FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                            <TextBlock x:Name="LowStockEmpty" Visibility="Collapsed" Text="All active ingredients are above their reorder threshold. No action needed." />
                            <TextBlock x:Name="LowStockError" Visibility="Collapsed" Foreground="{StaticResource ConsoleAccentTextBrush}" />
                            <ItemsControl x:Name="LowStockList" AutomationProperties.Name="Current low stock">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,10" ColumnSpacing="12" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding BalanceDisplay}" FontSize="13" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="REORDER AT" Style="{StaticResource ReportLabel}" />
                                                <TextBlock Text="{Binding ThresholdDisplay}" HorizontalAlignment="Right" FontSize="20" FontFamily="{StaticResource ConsoleSerifFont}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <controls:ConceptPattern Height="12" Margin="0,12,0,0" />
                            <Button Content="Open stock room" Click="OnOpenStockRoom" Style="{StaticResource ReportLink}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Canvas Grid.RowSpan="3" Canvas.ZIndex="1" SizeChanged="OnAssistantOverlaySizeChanged">
            <Grid x:Name="AssistantOverlay">
                <Button x:Name="AssistantLauncherButton" Style="{StaticResource ReportPrimary}" Width="276" Height="48" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Click="OnShowAssistant" Visibility="Collapsed" AutomationProperties.Name="Open reporting assistant chat">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Symbol="Message" Foreground="{StaticResource ConsoleAccentLightBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="Ask assistant" Foreground="{StaticResource ConsoleOnFieldBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <FontIcon Grid.Column="2" Glyph="&#xE70E;" FontSize="12" Foreground="{StaticResource ConsoleOnFieldBrush}" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </Button>
                <Border x:Name="AssistantPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" KeyDown="OnAssistantPanelKeyDown"
                        Background="{StaticResource AssistantSurfaceBrush}" BorderBrush="{StaticResource AssistantFrameBrush}" BorderThickness="1" CornerRadius="6"
                        AutomationProperties.Name="Reporting assistant chat">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Background="{StaticResource ConsoleFieldBrush}" Padding="14,4" BorderBrush="{StaticResource AssistantFrameBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Reporting assistant" Style="{StaticResource ReportHeading}" FontSize="22" Foreground="{StaticResource ConsoleOnFieldBrush}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                                <Button Grid.Column="1" Click="OnHideAssistant" Style="{StaticResource AssistantHeaderButton}" ToolTipService.ToolTip="Minimize chat (Esc)" AutomationProperties.Name="Minimize assistant chat">
                                    <FontIcon Glyph="&#xE921;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                                </Button>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AssistantPeriod" Text="Loading report dates…" FontSize="12" Foreground="{StaticResource ConsoleOnFieldMutedBrush}" VerticalAlignment="Center" />
                                <Button x:Name="AssistantDatesButton" Grid.Column="1" Content="Change dates" Click="OnAssistantDates" Style="{StaticResource AssistantHeaderButton}" />
                            </Grid>
                        </StackPanel>
                        <ScrollViewer x:Name="AssistantTranscriptScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" AutomationProperties.Name="Conversation">
                            <StackPanel Padding="16" Spacing="12">
                                <Expander x:Name="AssistantExamples" Header="Suggested questions" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="6">
                                        <Button Style="{StaticResource AssistantPromptButton}" Click="OnAssistantPrompt">
                                            <TextBlock Text="How did revenue, order count, and average order value change compared with the previous period?" TextWrapping="Wrap" />
                                        </Button>
                                        <Button Style="{StaticResource AssistantPromptButton}" Click="OnAssistantPrompt">
                                            <TextBlock Text="Which channel brought in the most revenue, and which three products generated the most revenue overall?" TextWrapping="Wrap" />
                                        </Button>
                                        <Button Style="{StaticResource AssistantPromptButton}" Click="OnAssistantPrompt">
                                            <TextBlock Text="Which day had the highest revenue, and how was revenue split across payment methods?" TextWrapping="Wrap" />
                                        </Button>
                                        <Button Style="{StaticResource AssistantPromptButton}" Click="OnAssistantPrompt">
                                            <TextBlock Text="Give me a four-week plan to grow the café using our sales and stock reports." TextWrapping="Wrap" />
                                        </Button>
                                    </StackPanel>
                                </Expander>
                                <StackPanel x:Name="AssistantMessages" Spacing="12" />
                                <StackPanel x:Name="AssistantProgress" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                    <ProgressRing x:Name="AssistantSpinner" Width="16" Height="16" IsActive="False" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Looking up reports…" FontSize="13" Foreground="{StaticResource ConsoleMutedInkBrush}" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="2" Background="{StaticResource AssistantComposerBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Padding="12" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AssistantQuestionBox" PlaceholderText="Ask a reporting question" MaxLength="2000" MinWidth="0" MinHeight="44" FontFamily="{StaticResource ConsoleSansFont}" FontSize="14"
                                     TextChanged="OnAssistantQuestionChanged" KeyDown="OnAssistantQuestionKeyDown" AutomationProperties.Name="Your message" />
                            <Button x:Name="AssistantAskButton" Grid.Column="1" Content="Send" Click="OnAskAssistant" Style="{StaticResource ReportPrimary}" MinHeight="44" VerticalAlignment="Stretch" IsEnabled="False" AutomationProperties.Name="Send message" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Canvas>
    </Grid>
</Page>
