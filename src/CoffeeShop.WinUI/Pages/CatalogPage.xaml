<Page
    x:Class="CoffeeShop.WinUI.Pages.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:CoffeeShop.Application.Catalog"
    FontFamily="{StaticResource SketchBodyFontFamily}"
    Foreground="{StaticResource SketchForegroundBrush}">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobbly}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource SketchBorderBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobbly}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource SketchBorderBrush}"/>
        </Style>
    </Page.Resources>
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="The menu notebook" FontFamily="{StaticResource SketchHeadingFontFamily}" FontSize="32"/>
            <TextBlock Text="Drinks, sizes, toppings, and a recipe for every cup." TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>
            <InfoBar x:Name="Status" IsOpen="True" IsClosable="False"/>
            <Button x:Name="ReloadButton" Content="Reload catalog" Click="OnReload" HorizontalAlignment="Left"/>
        </StackPanel>
        <Pivot Grid.Row="2" x:Name="WorkspaceTabs">
            <PivotItem Header="Drinks and recipes">
                <ScrollViewer>
                    <Grid x:Name="MenuLayout" RowSpacing="16" ColumnSpacing="24" Padding="0,8,8,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ListColumn" Width="*"/>
                            <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Expanded">
                                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1008"/></VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="ListColumn.Width" Value="2*"/>
                                        <Setter Target="DetailColumn.Width" Value="3*"/>
                                        <Setter Target="DetailPanel.(Grid.Column)" Value="1"/>
                                        <Setter Target="DetailPanel.(Grid.Row)" Value="0"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Compact"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel Spacing="16">
                            <TextBox x:Name="SearchBox" Header="Find a drink" PlaceholderText="Name or description" MaxLength="120"/>
                            <CheckBox x:Name="IncludeInactive" Content="Include inactive drinks" MinHeight="48"/>
                            <Button Content="Search" Click="OnSearch"/>
                            <Button Content="New drink" Click="OnNewDrink"/>
                            <TextBlock x:Name="EmptyMessage" Text="No drinks match. Clear the search or create a drink." TextWrapping="Wrap" Visibility="Collapsed"/>
                            <ListView x:Name="DrinksList" SelectionMode="Single" SelectionChanged="OnDrinkSelected" MaxHeight="480">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="catalog:MenuItemSummary">
                                        <StackPanel Padding="8" Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" FontSize="22" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind CategoryName}"/>
                                            <CheckBox Content="Active" IsChecked="{x:Bind IsActive}" IsEnabled="False"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        <Grid x:Name="DetailPanel" Grid.Row="1">
                            <Border Background="{StaticResource SketchBorderBrush}" CornerRadius="{StaticResource SketchCornerRadiusWobblyMd}" Translation="4,4,0"/>
                            <Border Background="{StaticResource SketchBackgroundBrush}" BorderBrush="{StaticResource SketchBorderBrush}" BorderThickness="2" CornerRadius="{StaticResource SketchCornerRadiusWobblyMd}" Padding="20">
                                <StackPanel Spacing="16">
                                    <TextBlock x:Name="DetailHeading" Text="Select a drink to open its notebook." FontSize="24" FontFamily="{StaticResource SketchHeadingFontFamily}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetailDescription" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="ItemActions" Spacing="12" Visibility="Collapsed">
                                        <Button Content="Edit drink" Click="OnEditDrink"/>
                                        <Button Content="Deactivate drink" Click="OnDeactivateDrink" BorderBrush="{StaticResource SketchAccentBrush}"/>
                                        <TextBlock Text="Sizes and their recipes" FontSize="22"/>
                                        <Button Content="Add a size" Click="OnNewVariant"/>
                                        <ListView x:Name="VariantsList" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="catalog:SizeVariantDetail">
                                                    <StackPanel Spacing="8" Padding="8">
                                                        <TextBlock Text="{x:Bind SizeName}" FontSize="22"/>
                                                        <TextBlock Text="{x:Bind Price}"/>
                                                        <CheckBox Content="Available" IsChecked="{x:Bind IsActive}" IsEnabled="False"/>
                                                        <Button Content="Edit size / price" Tag="{x:Bind}" Click="OnEditVariant"/>
                                                        <Button Content="Deactivate size" Tag="{x:Bind}" Click="OnDeactivateVariant" BorderBrush="{StaticResource SketchAccentBrush}"/>
                                                        <Button Content="View / edit recipe" Tag="{x:Bind}" Click="OnRecipe"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock Text="Compatible toppings" FontSize="22"/>
                                        <TextBlock x:Name="CompatibilityText" TextWrapping="Wrap"/>
                                        <Button Content="Choose compatible add-ons" Click="OnCompatibility"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Categories">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <TextBlock Text="Create an active category before adding drinks." TextWrapping="Wrap"/>
                        <Button Content="New category" Click="OnNewCategory" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="CategoriesEmpty" Text="No categories yet. Create one to begin."/>
                        <ListView x:Name="CategoriesList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="catalog:CategorySummary">
                                    <StackPanel Spacing="8" Padding="8">
                                        <TextBlock Text="{x:Bind Name}" FontSize="22"/>
                                        <CheckBox Content="Active" IsChecked="{x:Bind IsActive}" IsEnabled="False"/>
                                        <Button Content="Edit category" Tag="{x:Bind}" Click="OnEditCategory"/>
                                        <Button Content="Deactivate category" Tag="{x:Bind}" Click="OnDeactivateCategory" BorderBrush="{StaticResource SketchAccentBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="CategoryLimit" Text="Showing the first 200 categories." Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Add-ons">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <TextBlock Text="Define toppings here, then choose compatibility on each drink. One of each add-on per drink." TextWrapping="Wrap"/>
                        <Button Content="New add-on" Click="OnNewAddon" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="AddonsEmpty" Text="No add-ons yet. Toppings are optional."/>
                        <ListView x:Name="AddonsList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="catalog:AddonSummary">
                                    <StackPanel Spacing="8" Padding="8">
                                        <TextBlock Text="{x:Bind Name}" FontSize="22"/>
                                        <TextBlock Text="{x:Bind Price}"/>
                                        <CheckBox Content="Available" IsChecked="{x:Bind IsActive}" IsEnabled="False"/>
                                        <Button Content="Edit add-on" Tag="{x:Bind}" Click="OnEditAddon"/>
                                        <Button Content="Deactivate add-on" Tag="{x:Bind}" Click="OnDeactivateAddon" BorderBrush="{StaticResource SketchAccentBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
