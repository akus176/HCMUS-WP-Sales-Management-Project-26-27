<ContentDialog
    x:Class="CoffeeShop.WinUI.Pages.SupplierDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonClick="OnPrimaryClick">
    <StackPanel Spacing="12" MinWidth="360">
        <TextBox x:Name="NameBox" Header="Name" PlaceholderText="e.g. Bean Roasters" />
        <TextBox x:Name="PhoneBox" Header="Phone" PlaceholderText="0901234567" />
        <TextBox x:Name="EmailBox" Header="Email (optional)" PlaceholderText="sales@supplier.com" />
        <TextBox x:Name="AddressBox" Header="Address (optional)" PlaceholderText="12 Roast Street" />
    </StackPanel>
</ContentDialog>