<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:CoffeeShop.WinUI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoffeeShop.WinUI.Pages.StockRoomPage" Background="{StaticResource ConsoleGroundBrush}" FontFamily="Segoe UI" SizeChanged="OnRootSizeChanged">
    <Page.Resources>
        <!-- Keep console fields paper-toned while hovered or focused; the default WinUI
             text-control brushes paint a stark white box over the ledger. -->
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#B69355" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#B69355" />
        <!-- The history ingredient picker follows the same paper-and-rule treatment. -->
        <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#ECE5D9" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#E4DBCC" />
        <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D5CAB8" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#B69355" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#B69355" />
        <SolidColorBrush x:Key="IngredientSelectionBrush" Color="#D6E3EB" />
        <SolidColorBrush x:Key="IngredientSelectionEdgeBrush" Color="#37576A" />
        <Style x:Key="StockPrimary" TargetType="Button" BasedOn="{StaticResource ConsolePrimaryButtonStyle}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="20" />
        </Style>
        <Style x:Key="StockButton" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="20" />
        </Style>
        <Style x:Key="StockFine" TargetType="TextBlock" BasedOn="{StaticResource ConsoleLabelStyle}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="CharacterSpacing" Value="40" />
        </Style>
        <Style x:Key="StockStamp" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource ConsolePanelLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StockSecondary" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="BorderBrush" Value="{StaticResource ConsoleRuleBrush}" />
        </Style>
        <Style x:Key="StockPlainIcon" TargetType="Button" BasedOn="{StaticResource ConsoleIconButtonStyle}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="StockSortHeader" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Background" Value="{StaticResource ConsoleRuleBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Background" Value="{StaticResource ConsolePanelLineBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StockRowAction" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CharacterSpacing" Value="30" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleAccentTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Background" Value="{StaticResource ConsoleRuleBrush}" />
                                            <Setter Target="Label.Foreground" Value="{StaticResource ConsoleInkBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Background" Value="{StaticResource ConsolePanelLineBrush}" />
                                            <Setter Target="Label.Foreground" Value="{StaticResource ConsoleInkBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" CharacterSpacing="{TemplateBinding CharacterSpacing}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StockChip" TargetType="Button" BasedOn="{StaticResource StockSecondary}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="StockCheckBox" TargetType="CheckBox">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleAccentTextBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource ConsolePanelLineBrush}" BorderThickness="1" />
                                <FontIcon x:Name="CheckGlyph" Glyph="&#xE73E;" FontSize="10" Foreground="{StaticResource ConsoleOnFieldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Margin="9,0,0,0" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" CharacterSpacing="{TemplateBinding CharacterSpacing}" Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Box.BorderBrush" Value="{StaticResource ConsoleAccentBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Box.Background" Value="{StaticResource ConsolePanelBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Box.Opacity" Value="0.4" />
                                            <Setter Target="CheckGlyph.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Box.Background" Value="{StaticResource ConsoleAccentTextBrush}" />
                                            <Setter Target="Box.BorderBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
                                            <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <VisualState.Setters>
                                            <Setter Target="Box.BorderBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StockRecordSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ConsoleGroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConsolePanelLineBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="StockActorField" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource ConsoleRuleBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Background" Value="{StaticResource ConsolePanelBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Background" Value="{StaticResource ConsolePanelLineBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StockTab" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleTabStyle}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="0,0,0,9">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StockListItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource ConsoleAccentBrush}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="0.25" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Selection.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Selection.Opacity" Value="1" />
                                            <Setter Target="Hover.Opacity" Value="0.25" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Selection.Opacity" Value="1" />
                                            <Setter Target="Hover.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Selection" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="Hover" Background="{StaticResource ConsolePanelBrush}" Opacity="0" />
                            <ContentPresenter Content="{TemplateBinding Content}" DataContext="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StockIngredientListItem" TargetType="ListViewItem" BasedOn="{StaticResource StockListItem}">
            <Setter Property="Background" Value="{StaticResource IngredientSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource IngredientSelectionEdgeBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>
        <DataTemplate x:Key="StockStatusBadge">
            <Grid VerticalAlignment="Center">
                <Border Background="{StaticResource ConsoleConfirmedBrush}" Opacity="{Binding LowStockMarkerOpacity}" IsHitTestVisible="False" />
                <Border Style="{StaticResource StockStamp}">
                    <TextBlock Text="{Binding ShortStatus}" Style="{StaticResource StockFine}" Foreground="{StaticResource ConsoleAccentTextBrush}" />
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StockWideRow">
            <Grid Height="52" AutomationProperties.Name="{Binding RowAccessibilityName}">
                <Grid Padding="10,0,10,0" ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="16" LineHeight="18" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                        <TextBlock FontFamily="Segoe UI" Text="{Binding UnitDisplay}" Style="{StaticResource StockFine}" FontSize="10" CharacterSpacing="40" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Typography.NumeralStyle="Lining" Typography.NumeralAlignment="Tabular" LineHeight="18">
                        <Run FontFamily="Segoe UI" Text="{Binding BalanceNumber}" />
                        <Run Text="{Binding UnitSuffix}" FontFamily="Segoe UI" FontSize="9" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Typography.NumeralStyle="Lining" LineHeight="18">
                        <Run FontFamily="Segoe UI" Text="{Binding ThresholdNumber}" />
                        <Run Text="{Binding UnitSuffix}" FontFamily="Segoe UI" FontSize="9" />
                    </TextBlock>
                    <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource StockStatusBadge}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding LastMovementTooltip}">
                        <TextBlock FontFamily="Segoe UI" Text="{Binding LastMovementDisplay}" FontSize="10" Foreground="{StaticResource ConsoleMutedInkBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontFamily="Segoe UI" Text="{Binding LastMovementMeta}" FontSize="10" Foreground="{StaticResource ConsoleMutedInkBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="5" Content="Adjust" Style="{StaticResource StockRowAction}" Tag="{Binding}" Click="OnRowAdjustClick" AutomationProperties.Name="{Binding AdjustActionName}" ToolTipService.ToolTip="{Binding AdjustActionName}" />
                </Grid>
                <Rectangle Height="1" VerticalAlignment="Bottom" Margin="10,0,10,0" Fill="{StaticResource ConsoleRuleBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StockCompactRow">
            <Grid Height="52" AutomationProperties.Name="{Binding RowAccessibilityName}">
                <Grid Padding="10,0,10,0" ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="15" LineHeight="18" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" TextWrapping="Wrap" MaxLines="2" />
                        <TextBlock FontFamily="Segoe UI" Text="{Binding UnitDisplay}" Style="{StaticResource StockFine}" FontSize="10" CharacterSpacing="40" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Typography.NumeralStyle="Lining" Typography.NumeralAlignment="Tabular" LineHeight="18">
                        <Run FontFamily="Segoe UI" Text="{Binding BalanceNumber}" />
                        <Run Text="{Binding UnitSuffix}" FontFamily="Segoe UI" FontSize="9" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Typography.NumeralStyle="Lining" LineHeight="18">
                        <Run FontFamily="Segoe UI" Text="{Binding ThresholdNumber}" />
                        <Run Text="{Binding UnitSuffix}" FontFamily="Segoe UI" FontSize="9" />
                    </TextBlock>
                    <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource StockStatusBadge}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock FontFamily="Segoe UI" Text="{Binding LastMovementDisplay}" FontSize="10" Foreground="{StaticResource ConsoleMutedInkBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontFamily="Segoe UI" Text="{Binding LastMovementMeta}" FontSize="10" Foreground="{StaticResource ConsoleMutedInkBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="5" Content="Adjust" Style="{StaticResource StockRowAction}" Tag="{Binding}" Click="OnRowAdjustClick" AutomationProperties.Name="{Binding AdjustActionName}" ToolTipService.ToolTip="{Binding AdjustActionName}" />
                </Grid>
                <Rectangle Height="1" VerticalAlignment="Bottom" Margin="10,0,10,0" Fill="{StaticResource ConsoleRuleBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StockMovementWideRow">
            <Grid Padding="14,0" Height="46" ColumnSpacing="12" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe UI" Text="{Binding TimeDisplay}" Style="{StaticResource ConsoleLabelStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding FullTimeDisplay}" />
                <TextBlock Grid.Column="1" Text="{Binding IngredientName}" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding IngredientName}" />
                <Border Grid.Column="2" Style="{StaticResource ConsoleStampStyle}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TypeDisplay}" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource ConsoleMutedInkBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding TypeDisplay}" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding DeltaDisplay}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" Foreground="{Binding DeltaBrush}" VerticalAlignment="Center" />
                <TextBlock FontFamily="Segoe UI" Grid.Column="4" Text="{Binding ReasonDisplay}" Style="{StaticResource ConsoleBodyStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ReasonDisplay}" />
                <TextBlock FontFamily="Segoe UI" Grid.Column="5" Text="{Binding ActorDisplay}" Style="{StaticResource ConsoleLabelStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ActorDisplay}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StockMovementCompactRow">
            <Grid MinHeight="62" Padding="14,8" ColumnSpacing="10" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe UI" Text="{Binding TimeDisplay}" Style="{StaticResource ConsoleLabelStyle}" VerticalAlignment="Top" Margin="0,3,0,0" ToolTipService.ToolTip="{Binding FullTimeDisplay}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IngredientName}" FontFamily="Segoe UI" FontSize="14" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding IngredientName}" />
                    <TextBlock FontFamily="Segoe UI" Text="{Binding ReasonDisplay}" FontSize="10" Foreground="{StaticResource ConsoleMutedInkBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ReasonDisplay}" />
                    <TextBlock FontFamily="Segoe UI" Text="{Binding ContextDisplay}" FontSize="9" Foreground="{StaticResource ConsoleMutedInkBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ContextDisplay}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DeltaDisplay}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" Foreground="{Binding DeltaBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,3,0,0" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="RootGrid" Padding="{StaticResource ConsolePagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderGrid" Margin="0,0,0,10" ColumnSpacing="18" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Stock room" Style="{StaticResource ConsolePageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
