                                        <TextBlock FontFamily="Segoe UI" Text="REORDER AT" Style="{StaticResource StockFine}" FontSize="9" VerticalAlignment="Center" CharacterSpacing="20" />
                                        <TextBlock FontFamily="Segoe UI" x:Name="SortReorderIndicator" Text="↕" FontSize="8" VerticalAlignment="Center" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SortStatusButton" Grid.Column="3" Style="{StaticResource StockSortHeader}" Tag="status" Click="OnSortHeaderClick" AutomationProperties.Name="Sort ingredients by stock status" ToolTipService.ToolTip="Sort by stock status">
