                                        <TextBlock FontFamily="Segoe UI" Text="STATUS" Style="{StaticResource StockFine}" FontSize="9" VerticalAlignment="Center" CharacterSpacing="20" />
                                        <TextBlock FontFamily="Segoe UI" x:Name="SortStatusIndicator" Text="↑" FontSize="8" VerticalAlignment="Center" Foreground="{StaticResource ConsoleAccentTextBrush}" />
