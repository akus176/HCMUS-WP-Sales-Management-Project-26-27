                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource ConsoleStampStyle}" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe UI" Text="{Binding StatusDisplay}" Style="{StaticResource ConsoleLabelStyle}" />
                                                </Border>
                                                <Button Grid.Column="2" Content="Edit" Style="{StaticResource StockRowAction}" Tag="{Binding}" Click="OnEditSupplierClick" AutomationProperties.Name="{Binding EditActionName}" ToolTipService.ToolTip="{Binding EditActionName}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock FontFamily="Segoe UI" x:Name="SuppliersEmptyText" Text="No suppliers yet. Add a supplier before receiving a delivery." FontSize="13" TextWrapping="Wrap" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid x:Name="MovementsView" RowSpacing="12" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Movement history" FontFamily="Segoe UI" FontSize="24" />
                            <TextBlock FontFamily="Segoe UI" Text="Every recorded receipt, adjustment, and waste entry across the pantry — filter by ingredient to narrow the ledger." FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" />
                            <ComboBox FontFamily="Segoe UI" x:Name="HistoryIngredientBox" Width="320" MinHeight="44" Height="44" DisplayMemberPath="Name" FontSize="12" BorderThickness="0,0,0,1" CornerRadius="0" Padding="12,0" VerticalContentAlignment="Center" SelectionChanged="OnHistoryIngredientChanged" AutomationProperties.Name="Filter movement history by ingredient" AutomationProperties.HelpText="Choose All ingredients to review every recorded stock movement." />
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource ConsolePaperPanelStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="MovementHeaderWide" Padding="14,0" ColumnSpacing="12" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe UI" Text="When" Style="{StaticResource StockFine}" FontSize="9" VerticalAlignment="Center" />
                                    <TextBlock FontFamily="Segoe UI" Grid.Column="1" Text="Ingredient" Style="{StaticResource StockFine}" FontSize="9" VerticalAlignment="Center" />
                                    <TextBlock FontFamily="Segoe UI" Grid.Column="2" Text="Type" Style="{StaticResource StockFine}" FontSize="9" VerticalAlignment="Center" />
                                    <TextBlock FontFamily="Segoe UI" Grid.Column="3" Text="Change" Style="{StaticResource StockFine}" FontSize="9" VerticalAlignment="Center" />
                                    <TextBlock FontFamily="Segoe UI" Grid.Column="4" Text="Reason" Style="{StaticResource StockFine}" FontSize="9" VerticalAlignment="Center" />
                                    <TextBlock FontFamily="Segoe UI" Grid.Column="5" Text="Recorded by" Style="{StaticResource StockFine}" FontSize="9" VerticalAlignment="Center" />
                                </Grid>
                                <Grid x:Name="MovementHeaderCompact" Padding="14,0" ColumnSpacing="10" Visibility="Collapsed" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe UI" Text="When" Style="{StaticResource StockFine}" FontSize="9" VerticalAlignment="Center" />
                                    <TextBlock FontFamily="Segoe UI" Grid.Column="1" Text="Movement" Style="{StaticResource StockFine}" FontSize="9" VerticalAlignment="Center" />
                                    <TextBlock FontFamily="Segoe UI" Grid.Column="2" Text="Change" Style="{StaticResource StockFine}" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                                <ListView x:Name="MovementsListView" Grid.Row="1" SelectionMode="None" Padding="0" ItemContainerStyle="{StaticResource StockListItem}" ItemTemplate="{StaticResource StockMovementWideRow}" AutomationProperties.Name="Movement audit list">
                                </ListView>
                                <TextBlock FontFamily="Segoe UI" x:Name="HistoryEmptyText" Grid.Row="1" Text="No stock movements have been recorded yet." Margin="24" FontSize="13" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <Border x:Name="DrawerPanel" Grid.Column="1" Background="Transparent" Padding="0" VerticalAlignment="Top">
                    <Grid>
                        <!-- A flat record surface shares the console's ruled, editorial visual language. -->
                        <Border Style="{StaticResource StockRecordSurface}">
                            <Grid>
                                <!-- Reuse the table's brass lattice as a narrow frame, clear of the content. -->
                                <Border Margin="6" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                <Grid Height="12" Margin="2,1,2,0" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                    <controls:ConceptPattern />
                                </Grid>
                                <Grid Height="12" Margin="2,0,2,1" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                    <controls:ConceptPattern />
                                </Grid>
                                <Grid Width="12" Margin="1,13,0,13" HorizontalAlignment="Left" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                    <controls:ConceptPattern />
                                </Grid>
                                <Grid Width="12" Margin="0,13,1,13" HorizontalAlignment="Right" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                    <controls:ConceptPattern />
                                </Grid>
                                <Grid Padding="20,18,8,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ScrollViewer x:Name="DrawerScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar">
                                                <Setter Property="Width" Value="6" />
                                                <Setter Property="MinWidth" Value="6" />
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#7AB69355" />
                                            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#A8B69355" />
                                            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#C6B69355" />
                                            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                                            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="Transparent" />
                                            <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="Transparent" />
                                        </ScrollViewer.Resources>
                                        <Grid x:Name="DrawerContent" MinHeight="{Binding ViewportHeight, ElementName=DrawerScrollViewer}" Margin="0,0,12,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <Grid ColumnSpacing="8" Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontFamily="Segoe UI" Text="INGREDIENT DETAILS" Style="{StaticResource StockFine}" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource ConsoleAccentTextBrush}" x:Name="DrawerKicker" />
                                                        <TextBlock x:Name="DrawerIngredientTitle" Text="Select an ingredient" FontFamily="Segoe UI" FontSize="28" LineHeight="30" Margin="0,7,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                    </StackPanel>
                                                    <Button x:Name="DrawerCloseButton" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource StockPlainIcon}" Click="OnDrawerCloseClick" AutomationProperties.Name="Close ingredient details">
                                                        <Image Source="ms-appx:///Assets/Icons/i-x.svg" Width="12" Height="12" />
                                                    </Button>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,16" x:Name="DrawerTagsPanel">
                                                    <Border x:Name="DrawerStatusStamp" Style="{StaticResource StockStamp}" Padding="8,4" BorderThickness="0" Background="{StaticResource ConsoleRaisedGroundBrush}">
                                                        <TextBlock FontFamily="Segoe UI" x:Name="DrawerStatusText" Text="STATUS" Style="{StaticResource StockFine}" FontSize="11" Foreground="{StaticResource ConsoleAccentTextBrush}" />
                                                    </Border>
                                                    <TextBlock FontFamily="Segoe UI" x:Name="DrawerUnitTag" Text="Base unit" FontSize="11" Foreground="{StaticResource ConsoleMutedInkBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border Background="{StaticResource ConsoleRaisedGroundBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock FontFamily="Segoe UI" Text="ON HAND" Style="{StaticResource StockFine}" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                                        <TextBlock FontFamily="Segoe UI" FontSize="42" LineHeight="46" Margin="0,4,0,4" Foreground="{StaticResource ConsoleInkBrush}" Typography.NumeralStyle="Lining" Typography.NumeralAlignment="Tabular">
                                                            <Run FontFamily="Segoe UI" x:Name="DrawerBalanceValue" Text="0" />
                                                            <Run FontFamily="Segoe UI" x:Name="DrawerBalanceUnit" FontSize="18" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                                        </TextBlock>
                                                        <TextBlock FontFamily="Segoe UI" x:Name="DrawerThresholdMeta" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="BeginAdjustmentButton" Content="Adjust stock" Style="{StaticResource StockPrimary}" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnBeginAdjustmentClick" AutomationProperties.Name="Adjust selected ingredient stock" />
                                                <StackPanel x:Name="AdjustmentForm" Visibility="Collapsed">
                                                    <TextBlock FontFamily="Segoe UI" Text="Quantity change" Style="{StaticResource StockFine}" Margin="0,9,0,4" FontSize="11" />
                                                    <Grid BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="DeltaInputBox" Style="{StaticResource ConsoleFieldStyle}" FontFamily="Segoe UI" FontSize="26" TextAlignment="Center" Height="48" BorderThickness="0" PlaceholderText="0" TextChanged="OnDeltaInputChanged" AutomationProperties.Name="Adjustment delta quantity" />
                                                        <TextBlock x:Name="DeltaUnitText" Grid.Column="1" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource ConsoleMutedInkBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,5,0,0">
                                                        <Button Content="−5" Style="{StaticResource StockChip}" Click="OnQuickChipClick" Tag="-5" AutomationProperties.Name="Decrease quantity by 5" />
                                                        <Button Content="−10" Style="{StaticResource StockChip}" Click="OnQuickChipClick" Tag="-10" AutomationProperties.Name="Decrease quantity by 10" />
                                                        <Button Content="+5" Style="{StaticResource StockChip}" Click="OnQuickChipClick" Tag="5" AutomationProperties.Name="Increase quantity by 5" />
                                                        <Button Content="+10" Style="{StaticResource StockChip}" Click="OnQuickChipClick" Tag="10" AutomationProperties.Name="Increase quantity by 10" />
                                                        <Button Content="+250" Style="{StaticResource StockChip}" Click="OnQuickChipClick" Tag="250" AutomationProperties.Name="Increase quantity by 250" />
                                                    </StackPanel>
                                                    <Grid BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1" Height="44" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontFamily="Segoe UI" Text="New balance" FontSize="9" Foreground="{StaticResource ConsoleMutedInkBrush}" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="ProjectedBalanceText" Grid.Column="1" Text="—" FontFamily="Segoe UI" FontSize="20" VerticalAlignment="Center" />
                                                        <Border x:Name="ProjectedStatusStamp" Grid.Column="2" Style="{StaticResource StockStamp}" Visibility="Collapsed">
                                                            <TextBlock FontFamily="Segoe UI" x:Name="ProjectedStatusText" Text="BELOW REORDER" Style="{StaticResource StockFine}" FontSize="9" Foreground="{StaticResource ConsoleAccentTextBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <Grid Margin="0,8,0,6" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontFamily="Segoe UI" Text="Reason" Style="{StaticResource StockFine}" FontSize="11" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                            <Rectangle Width="14" Height="1" Fill="{StaticResource ConsoleRuleBrush}" VerticalAlignment="Center" />
                                                            <TextBlock FontFamily="Segoe UI" Text="REQUIRED" Style="{StaticResource StockFine}" FontSize="8" CharacterSpacing="140" Foreground="{StaticResource ConsoleAccentTextBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBox FontFamily="Segoe UI" x:Name="ReasonInputBox" PlaceholderText="Why did the stock change?" AcceptsReturn="True" Height="48" MinHeight="48" MaxLength="255" TextWrapping="Wrap" Style="{StaticResource ConsoleFieldStyle}" FontSize="12" PlaceholderForeground="{StaticResource ConsoleMutedInkBrush}" AutomationProperties.Name="Adjustment reason (required)" AutomationProperties.HelpText="Enter the reason recorded in the stock movement history." TextChanged="OnAdjustmentInputChanged" />
                                                    <TextBlock FontFamily="Segoe UI" Text="Recorded by" Style="{StaticResource StockFine}" Margin="0,8,0,2" FontSize="11" />
                                                    <Button x:Name="ActorButton" Style="{StaticResource StockActorField}" AutomationProperties.Name="Change adjustment staff operator" AutomationProperties.HelpText="Select the staff operator recorded on this stock movement">
                                                        <Button.Flyout>
                                                            <Flyout>
                                                                <StackPanel Spacing="8" Width="280">
                                                                    <TextBlock FontFamily="Segoe UI" Text="STAFF OPERATOR" Style="{StaticResource ConsoleLabelStyle}" />
                                                                    <ComboBox FontFamily="Segoe UI" x:Name="DrawerOperatorBox" DisplayMemberPath="FullName" HorizontalAlignment="Stretch" MinHeight="48" SelectionChanged="OnDrawerOperatorChanged" AutomationProperties.Name="Adjustment staff operator" />
                                                                </StackPanel>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                        <TextBlock FontFamily="Segoe UI" x:Name="ActorDisplayText" Text="Choose staff operator · change" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                    <TextBlock FontFamily="Segoe UI" x:Name="AuditActorNote" Text="This movement cannot be edited or deleted after saving." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource ConsoleMutedInkBrush}" Margin="0,3,0,0" />
                                                    <TextBlock FontFamily="Segoe UI" x:Name="AdjustmentHintText" Text="Enter a quantity change and a reason for the audit trail." FontSize="11" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" Margin="0,8,0,6" AutomationProperties.LiveSetting="Polite" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Row="1" VerticalAlignment="Bottom" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,24,0,0" x:Name="RecentHistoryPanel">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontFamily="Segoe UI" Text="RECENT MOVEMENTS" Style="{StaticResource StockFine}" FontSize="10" Foreground="{StaticResource ConsoleAccentTextBrush}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Content="View history" Style="{StaticResource StockSecondary}" Height="44" BorderThickness="0" Padding="0" Click="OnOpenHistoryClick" AutomationProperties.Name="Open full stock movement history" FontSize="11" />
                                                    </Grid>
                                                    <ListView x:Name="IngredientMovementsList" SelectionMode="None" MaxHeight="180" ItemContainerStyle="{StaticResource StockListItem}" AutomationProperties.Name="Recent ingredient movements">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid MinHeight="58" Padding="0,8" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1" ColumnSpacing="8" RowSpacing="3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Text="{Binding DeltaDisplay}" FontFamily="Segoe UI" FontSize="18" Foreground="{Binding DeltaBrush}" VerticalAlignment="Center" />
                                                                    <TextBlock FontFamily="Segoe UI" Grid.Column="1" Text="{Binding TimeDisplay}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource ConsoleMutedInkBrush}" ToolTipService.ToolTip="{Binding FullTimeDisplay}" />
                                                                    <TextBlock FontFamily="Segoe UI" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ReasonDisplay}" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{StaticResource ConsoleMutedInkBrush}" ToolTipService.ToolTip="{Binding ReasonDisplay}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                    <TextBlock FontFamily="Segoe UI" x:Name="NoMovementsText" Text="No recorded movements." Style="{StaticResource StockFine}" FontSize="11" Margin="0,8,0,4" Visibility="Collapsed" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </ScrollViewer>
                                    <Grid x:Name="AdjustmentActions" Grid.Row="1" ColumnSpacing="8" Margin="0,12,12,0" Padding="0,12,0,0" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="RecordAdjustmentButton" Content="Save adjustment" Style="{StaticResource StockPrimary}" HorizontalAlignment="Stretch" Click="OnRecordAdjustmentClick" AutomationProperties.Name="Record stock adjustment" />
                                        <Button x:Name="CancelAdjustmentButton" Grid.Column="1" Content="Cancel" Style="{StaticResource StockButton}" Click="OnCancelAdjustmentClick" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
