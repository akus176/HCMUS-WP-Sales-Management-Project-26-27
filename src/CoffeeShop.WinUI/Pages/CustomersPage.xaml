<Page
    x:Class="CoffeeShop.WinUI.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource SketchBodyFontFamily}"
    Background="{StaticResource SketchBackgroundBrush}"
    RequestedTheme="Light"
    Foreground="{StaticResource SketchForegroundBrush}">
    <Page.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SketchCustomerButtonStyle}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource SketchCustomerFieldStyle}"/>
        <Style TargetType="CheckBox"><Setter Property="MinHeight" Value="48"/></Style>
    </Page.Resources>
    <Grid Padding="24" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Expanded">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1008"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="2*"/>
                        <Setter Target="DetailColumn.Width" Value="3*"/>
                        <Setter Target="DetailPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="DetailPanel.(Grid.Row)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Compact"/>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="The customer notebook" FontFamily="{StaticResource SketchHeadingFontFamily}" FontSize="32" TextWrapping="Wrap"/>
            <TextBlock Text="Familiar faces, delivery details, and a little loyalty with every cup." TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Loading customers"/>
            <InfoBar x:Name="Status" IsOpen="True" IsClosable="False"/>
            <Button x:Name="ReloadButton" Content="Reload customers" Click="OnReload"/>
        </StackPanel>
        <ScrollViewer x:Name="WorkspaceContent" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Padding="0,0,8,16">
                <Grid ColumnSpacing="24" RowSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ListColumn" Width="*"/>
                        <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="12">
                        <TextBox x:Name="SearchBox" Header="Find a customer" PlaceholderText="Name, phone, or email" MaxLength="120" KeyDown="OnSearchKeyDown"/>
                        <CheckBox x:Name="IncludeInactive" Content="Include inactive profiles"/>
                        <Button Content="Search" Click="OnSearch"/>
                        <Button x:Name="NewCustomerButton" Content="New customer" Click="OnNewCustomer"/>
                        <TextBlock x:Name="EmptyMessage" Text="No customers match. Clear the search or create a profile. Walk-ins can continue below." TextWrapping="Wrap" Visibility="Collapsed"/>
                        <ListView ContainerContentChanging="OnContainerContentChanging" x:Name="CustomersList" SelectionMode="Single" SelectionChanged="OnCustomerSelected" MaxHeight="460" AutomationProperties.Name="Customer search results">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8" Spacing="4">
                                        <TextBlock Text="{Binding FullName}" FontSize="22" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Phone}"/>
                                        <TextBlock Text="{Binding Email}" TextWrapping="Wrap"/>
                                        <CheckBox Content="Active profile" IsChecked="{Binding IsActive}" IsEnabled="False"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <Grid x:Name="DetailPanel" Grid.Row="1">
                        <Border Background="{StaticResource SketchBorderBrush}" CornerRadius="{StaticResource SketchCornerRadiusWobblyMd}" Translation="4,4,0"/>
                        <Border Style="{StaticResource SketchCustomerCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="DetailHeading" Text="Select a customer to open their notebook." Style="{StaticResource SketchCustomerHeadingStyle}"/>
                                <TextBlock x:Name="ContactDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <TextBlock x:Name="BalanceText" FontSize="26" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                <StackPanel x:Name="ProfileActions" Spacing="8">
                                    <Button x:Name="EditCustomerButton" Content="Edit profile" Click="OnEditCustomer"/>
                                    <Button x:Name="DeactivateCustomerButton" Content="Deactivate profile" Click="OnDeactivateCustomer" BorderBrush="{StaticResource SketchAccentBrush}"/>
                                    <TextBlock Text="Delivery addresses" Style="{StaticResource SketchCustomerHeadingStyle}"/>
                                    <Button x:Name="AddAddressButton" Content="Add address" Click="OnAddAddress"/>
                                </StackPanel>
                                <TextBlock x:Name="AddressesEmpty" Text="No saved addresses. Add one or use an order-only address below." TextWrapping="Wrap"/>
                                <ListView ContainerContentChanging="OnContainerContentChanging" x:Name="AddressesList" SelectionMode="None" MaxHeight="320" AutomationProperties.Name="Saved delivery addresses">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="8" Spacing="4">
                                                <TextBlock Text="{Binding Label}" FontSize="22" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AddressLine}" TextWrapping="Wrap"/>
                                                <CheckBox Content="Default address" IsChecked="{Binding IsDefault}" IsEnabled="False"/>
                                                <CheckBox Content="Active address" IsChecked="{Binding IsActive}" IsEnabled="False"/>
                                                <Button Content="Edit address" Tag="{Binding}" Click="OnEditAddress" IsEnabled="{Binding IsActive}"/>
                                                <Button Content="Make default" Tag="{Binding}" Click="OnDefaultAddress" IsEnabled="{Binding IsActive}"/>
                                                <Button Content="Deactivate address" Tag="{Binding}" Click="OnDeactivateAddress" IsEnabled="{Binding IsActive}" BorderBrush="{StaticResource SketchAccentBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="Loyalty history" Style="{StaticResource SketchCustomerHeadingStyle}"/>
                                <TextBlock x:Name="HistoryEmpty" Text="No loyalty transactions yet."/>
                                <ListView ContainerContentChanging="OnContainerContentChanging" x:Name="HistoryList" SelectionMode="None" MaxHeight="380" AutomationProperties.Name="Loyalty transaction history">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="8" Spacing="4">
                                                <TextBlock Text="{Binding Type}" FontSize="22"/>
                                                <TextBlock Text="{Binding CreatedAt}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="Points:"/><TextBlock Text="{Binding Points}"/>
                                                    <TextBlock Text="Balance:"/><TextBlock Text="{Binding BalanceAfter}"/>
                                                </StackPanel>
                                                <TextBlock Text="Order reference"/><TextBlock Text="{Binding OrderId}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                                <TextBlock Text="Reverses transaction"/><TextBlock Text="{Binding ReversesTransactionId}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="HistoryPageText" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="PreviousButton" Content="Previous" Click="OnPreviousHistory"/>
                                    <Button x:Name="NextButton" Content="Next" Click="OnNextHistory"/>
                                </StackPanel>
                                <TextBlock Text="Recent orders" Style="{StaticResource SketchCustomerHeadingStyle}"/>
                                <TextBlock x:Name="OrdersEmpty" Text="No recent orders."/>
                                <ListView ContainerContentChanging="OnContainerContentChanging" x:Name="OrdersList" SelectionMode="None" MaxHeight="240" AutomationProperties.Name="Recent customer orders">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="8" Spacing="4">
                                                <TextBlock Text="{Binding OrderNumber}" FontSize="22"/>
                                                <TextBlock Text="{Binding Status}"/>
                                                <TextBlock Text="{Binding CreatedAt}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Total:"/><TextBlock Text="{Binding Total}"/></StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                <Border Style="{StaticResource SketchCustomerCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Customer for the next order" Style="{StaticResource SketchCustomerHeadingStyle}"/>
                        <TextBlock x:Name="OrderSummary" Text="Walk-in — no profile required." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <Button Content="Continue as walk-in" Click="OnWalkIn"/>
                        <CheckBox x:Name="UseSelectedProfile" Content="Use the selected profile" Checked="OnOrderOptionsChanged" Unchecked="OnOrderOptionsChanged"/>
                        <CheckBox x:Name="DeliveryOrder" Content="Delivery order" Checked="OnOrderOptionsChanged" Unchecked="OnOrderOptionsChanged"/>
                        <StackPanel x:Name="DeliveryFields" Spacing="12" Visibility="Collapsed">
                            <TextBox x:Name="RecipientName" Header="Recipient name" MaxLength="120"/>
                            <TextBox x:Name="ContactNumber" Header="Contact number" MaxLength="30"/>
                            <ComboBox x:Name="AddressChoice" Header="Delivery address" DisplayMemberPath="DisplayName" SelectionChanged="OnAddressChoiceChanged" MinHeight="48" HorizontalAlignment="Stretch"/>
                            <TextBox x:Name="OrderAddress" Header="Order-only address" PlaceholderText="Used for this order without saving to a profile" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="SelectForOrderButton" Content="Use these details for next order" Click="OnSelectForOrder"/>
                        <TextBlock Text="This selection is kept while you browse. A customer profile is optional; delivery contact details are required for deliveries." TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
