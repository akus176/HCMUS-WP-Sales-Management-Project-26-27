<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoffeeShop.WinUI.Pages.CustomersPage" FontFamily="{StaticResource ConsoleSansFont}" Background="{StaticResource ConsoleGroundBrush}" Foreground="{StaticResource ConsoleInkBrush}" RequestedTheme="Light" SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <DataTemplate x:Key="CustomerCheckContent">
            <TextBlock Text="{Binding}" Style="{x:Null}" FontFamily="{StaticResource ConsoleSansFont}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DataTemplate>
        <Style x:Key="CustomerButton" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CharacterSpacing" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="CustomerPrimary" TargetType="Button" BasedOn="{StaticResource ConsolePrimaryButtonStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CharacterSpacing" Value="0" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="CustomerLink" TargetType="Button" BasedOn="{StaticResource CustomerButton}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleAccentTextBrush}" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="CustomerText" TargetType="TextBlock" BasedOn="{StaticResource ConsoleBodyStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CustomerHeading" TargetType="TextBlock" BasedOn="{StaticResource ConsoleSectionTitleStyle}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CustomerLabel" TargetType="TextBlock" BasedOn="{StaticResource ConsoleLabelStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="60" />
        </Style>
        <Style x:Key="CustomerField" TargetType="TextBox" BasedOn="{StaticResource ConsoleFieldStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style x:Key="CustomerListItem" TargetType="ListViewItem" BasedOn="{StaticResource WorkspaceListItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="CustomerDialog" TargetType="ContentDialog" BasedOn="{StaticResource WorkspaceDialog}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="PrimaryButtonStyle" Value="{StaticResource CustomerPrimary}" />
            <Setter Property="CloseButtonStyle" Value="{StaticResource CustomerButton}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource CustomerButton}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource CustomerField}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource CustomerText}" />
        <Style TargetType="ListViewItem" BasedOn="{StaticResource CustomerListItem}" />
        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ContentTemplate" Value="{StaticResource CustomerCheckContent}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentLightBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckSurface" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CheckSurface.Opacity" Value=".8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="CheckSurface.Opacity" Value=".65" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="CheckSurface.Opacity" Value=".4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="CheckMark.Opacity" Value="1" />
                                            <Setter Target="CheckBoxSurface.Background" Value="{StaticResource ConsoleAccentLightBrush}" />
                                            <Setter Target="CheckBoxSurface.BorderBrush" Value="{StaticResource ConsoleAccentLightBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <VisualState.Setters>
                                            <Setter Target="CheckMark.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnSpacing="8" MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBoxSurface" Width="20" Height="20" VerticalAlignment="Center" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="2">
                                    <FontIcon x:Name="CheckMark" Glyph="" FontSize="12" Opacity="0" Foreground="{StaticResource ConsoleInkBrush}" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource ConsoleSansFont}" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Padding="24,18,24,24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Padding="0,0,0,16" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,0,0,1" ColumnSpacing="18" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="3">
                <TextBlock x:Name="ProfileCount" Text="MANAGE / CUSTOMER NOTEBOOK" Style="{StaticResource CustomerLabel}" />
                <TextBlock Text="Customers" Style="{StaticResource ConsolePageTitleStyle}" x:Name="CustomerTitle" FontSize="52" />
                <TextBlock Text="Familiar faces, saved addresses, loyalty, and the next order in one place." />
            </StackPanel>
            <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="ReloadButton" Content="Refresh" Click="OnReload" />
                <Button x:Name="NewCustomerButton" Content="+ New customer" Style="{StaticResource CustomerPrimary}" Click="OnNewCustomer" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="4">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Loading customers" />
            <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" />
        </StackPanel>
        <ScrollViewer x:Name="WorkspaceContent" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" SizeChanged="OnPageSizeChanged">
            <Grid x:Name="CustomerLayout" ColumnSpacing="18" RowSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="280" />
                    <ColumnDefinition x:Name="DetailColumn" Width="*" />
                    <ColumnDefinition x:Name="OrderColumn" Width="282" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="DirectoryPanel" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,1,0" Padding="0,0,12,0" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1" Background="{StaticResource ConsoleRaisedGroundBrush}" MinHeight="44">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="" FontSize="13" Foreground="{StaticResource ConsoleMutedInkBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox" PlaceholderText="Name, phone, or email" AutomationProperties.Name="Find a customer" MaxLength="120" KeyDown="OnSearchKeyDown" FontSize="13" MinHeight="44" Grid.Column="1" Padding="0" BorderThickness="0" VerticalContentAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Loaded="OnSearchBoxLoaded">
                                </TextBox>
                            <Button Grid.Column="2" Content="Search" Click="OnSearch" Style="{StaticResource CustomerLink}" MinHeight="44" FontSize="12" Padding="8,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="IncludeInactive" Content="Show inactive" Checked="OnInactiveChanged" Unchecked="OnInactiveChanged" MinHeight="40" />
                        <TextBlock x:Name="ResultsCount" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                    </Grid>
                    <Border x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource ConsoleRaisedGroundBrush}" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="EmptyMessage" Text="No matching customers. Try another search or create a profile." />
                            <Button Content="Clear search" Click="OnClearSearch" Style="{StaticResource CustomerLink}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <ListView x:Name="CustomersList" SelectionMode="Single" SelectionChanged="OnCustomerSelected" ContainerContentChanging="OnContainerContentChanging" AutomationProperties.Name="Customer search results" Grid.Row="3" Padding="0,0,24,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#E4DBCC" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#76591F" />
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,10" ColumnSpacing="10" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{StaticResource ConsolePanelBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding FullName}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="18" Foreground="{StaticResource ConsoleInkBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FullName}" />
                                        <TextBlock Text="{Binding ContactDisplay}" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LoyaltyPointsBalance}" Style="{StaticResource ConsoleNumberStyle}" FontSize="20" HorizontalAlignment="Right" />
                                        <TextBlock Text="points" FontSize="11" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <ScrollViewer x:Name="DetailScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Spacing="14" Margin="0,0,24,0">
                        <Border BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,0,0,1" Padding="0,4,0,9">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="6">
                                    <StackPanel Spacing="3">
                                        <TextBlock x:Name="DetailHeading" Text="Select a customer" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="30" Foreground="{StaticResource ConsoleInkBrush}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ContactDetails" FontSize="13" IsTextSelectionEnabled="True" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                    </StackPanel>
                                    <StackPanel x:Name="ProfileActions" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="EditCustomerButton" Content="Edit profile" AutomationProperties.Name="Edit customer profile" Click="OnEditCustomer" Style="{StaticResource CustomerLink}" />
                                        <Button x:Name="DeactivateCustomerButton" Content="Deactivate" AutomationProperties.Name="Deactivate customer" Click="OnDeactivateCustomer" Style="{StaticResource CustomerLink}" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Background="{StaticResource ConsolePanelBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Padding="10,7">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="LOYALTY BALANCE" Style="{StaticResource CustomerLabel}" FontSize="11" />
                                        <TextBlock x:Name="BalanceText" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="32" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Grid x:Name="ProfileLower" ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AddressColumn" Width="*" />
                                <ColumnDefinition x:Name="HistoryColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="AddressPanel" Spacing="8">
                                <Grid MinHeight="44" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Saved addresses" Style="{StaticResource CustomerHeading}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="AddAddressButton" Content="+ Add" Click="OnAddAddress" Style="{StaticResource CustomerLink}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="AddressesEmpty" Text="No saved addresses. Add one or use an order-only address." />
                                <ListView x:Name="AddressesList" SelectionMode="None" MaxHeight="350" AutomationProperties.Name="Saved delivery addresses" ContainerContentChanging="OnContainerContentChanging" Padding="0,0,24,0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ConsolePaperPanelStyle}" Padding="10" Margin="0,0,0,8" Background="{StaticResource ConsoleRaisedGroundBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="48" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="20" />
                                                            <TextBlock Text="{Binding StateDisplay}" FontSize="11" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="More" AutomationProperties.Name="Manage saved address" Style="{StaticResource CustomerLink}" FontSize="12">
                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                    <MenuFlyoutItem Text="Edit address" Tag="{Binding Address}" Click="OnEditAddress" IsEnabled="{Binding IsActive}" />
                                                                    <MenuFlyoutItem Text="Make default" Tag="{Binding Address}" Click="OnDefaultAddress" IsEnabled="{Binding IsActive}" />
                                                                    <MenuFlyoutItem Text="Deactivate" Tag="{Binding Address}" Click="OnDeactivateAddress" IsEnabled="{Binding IsActive}" />
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Text="{Binding AddressLine}" FontSize="13" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <StackPanel x:Name="HistoryPanel" Grid.Column="1" Spacing="8">
                                <Grid MinHeight="44">
                                    <TextBlock Text="Loyalty ledger" Style="{StaticResource CustomerHeading}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="HistoryEmpty" Text="No loyalty transactions yet." />
                                <ListView x:Name="HistoryList" SelectionMode="None" MaxHeight="350" ContainerContentChanging="OnContainerContentChanging" AutomationProperties.Name="Loyalty transaction history" Padding="0,0,24,0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,10" ColumnSpacing="8" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding Type}" />
                                                    <TextBlock Text="{Binding DateDisplay}" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                                    <TextBlock Text="{Binding OrderDisplay}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{Binding ReferenceDetails}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding PointsDisplay}" Style="{StaticResource ConsoleNumberStyle}" FontSize="22" />
                                                    <TextBlock Text="{Binding BalanceDisplay}" FontSize="12" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="HistoryPageText" Visibility="Collapsed" />
                                <StackPanel x:Name="HistoryPagination" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                    <Button x:Name="PreviousButton" Content="Previous" Click="OnPreviousHistory" />
                                    <Button x:Name="NextButton" Content="Next" Click="OnNextHistory" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="OrderScroll" Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OrderPanel" Spacing="16" Margin="0,0,24,0">
                        <Border RequestedTheme="Dark" Background="{StaticResource ConsoleFieldBrush}" Padding="16" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,2,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="ORDER AT COUNTER" Style="{StaticResource CustomerLabel}" Foreground="{StaticResource ConsoleOnFieldMutedBrush}" />
                                <TextBlock x:Name="OrderSummary" Text="Walk-in — no profile required." FontFamily="{StaticResource ConsoleSerifFont}" FontSize="25" Foreground="{StaticResource ConsoleOnFieldBrush}" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="Send this customer to Counter, then add items to their ticket. Add delivery details when needed." FontSize="13" Foreground="{StaticResource ConsoleOnFieldMutedBrush}" TextWrapping="Wrap" />
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="UseSelectedProfile" Content="Use the selected profile" Foreground="{StaticResource ConsoleOnFieldBrush}" Checked="OnOrderOptionsChanged" Unchecked="OnOrderOptionsChanged" />
                                    <CheckBox x:Name="DeliveryOrder" Content="Delivery order" Foreground="{StaticResource ConsoleOnFieldBrush}" Checked="OnOrderOptionsChanged" Unchecked="OnOrderOptionsChanged" />
                                    <StackPanel x:Name="DeliveryFields" RequestedTheme="Light" Spacing="12" Visibility="Collapsed" Background="{StaticResource ConsoleGroundBrush}" Padding="12">
                                        <TextBox x:Name="RecipientName" Header="Recipient name" MaxLength="120" />
                                        <TextBox x:Name="ContactNumber" Header="Contact number" MaxLength="30" />
                                        <ComboBox x:Name="AddressChoice" Header="Delivery address" DisplayMemberPath="DisplayName" SelectionChanged="OnAddressChoiceChanged" MinHeight="44" HorizontalAlignment="Stretch" FontSize="14" />
                                        <TextBox x:Name="OrderAddress" Header="Order-only address" PlaceholderText="Used for this order without saving to a profile" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="SelectForOrderButton" Content="Continue to Counter" Click="OnSelectForOrder" Background="{StaticResource ConsoleGroundBrush}" HorizontalAlignment="Stretch" />
                                    <Button Content="Walk-in at Counter" Click="OnWalkIn" Foreground="{StaticResource ConsoleOnFieldBrush}" Style="{StaticResource CustomerLink}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="8" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <TextBlock Text="Recent orders" Style="{StaticResource CustomerHeading}" />
                            <TextBlock x:Name="OrdersEmpty" Text="No recent orders." />
                            <ListView x:Name="OrdersList" SelectionMode="None" MaxHeight="280" ContainerContentChanging="OnContainerContentChanging" AutomationProperties.Name="Recent customer orders" Padding="0,0,24,0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,10" ColumnSpacing="8" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="12" />
                                                <TextBlock Text="{Binding DateDisplay}" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalDisplay}" Style="{StaticResource ConsoleNumberStyle}" FontSize="21" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
