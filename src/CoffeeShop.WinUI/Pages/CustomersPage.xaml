<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CoffeeShop.WinUI.Controls" x:Class="CoffeeShop.WinUI.Pages.CustomersPage" FontFamily="{StaticResource ConsoleSansFont}" Background="{StaticResource ConsoleGroundBrush}" Foreground="{StaticResource ConsoleInkBrush}" RequestedTheme="Light" SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource WorkspaceButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource ConsoleFieldStyle}"/>
        <Style TargetType="TextBlock" BasedOn="{StaticResource WorkspaceText}"/>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource WorkspaceListItem}"/>
        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Page.Resources>
    <Grid Padding="32,20,32,22" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Padding="0,0,0,10" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,0,0,3" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="116"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock x:Name="ProfileCount" Text="MANAGE / CUSTOMER NOTEBOOK" Style="{StaticResource WorkspaceLabel}"/>
                <TextBlock Text="Customers" Style="{StaticResource ConsolePageTitleStyle}"/>
                <TextBlock Text="Familiar faces, saved addresses, loyalty, and the next order in one place."/>
            </StackPanel>
            <Image x:Name="HeaderOrnament" Grid.Column="1" Source="ms-appx:///Assets/Ornaments/customers.svg" Height="78" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
            <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="ReloadButton" Content="Refresh" Click="OnReload"/>
                <Button x:Name="NewCustomerButton" Content="+ New customer" Style="{StaticResource WorkspacePrimary}" Click="OnNewCustomer"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="4">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Loading customers"/>
            <InfoBar x:Name="Status" IsOpen="False" IsClosable="True"/>
        </StackPanel>
        <ScrollViewer x:Name="WorkspaceContent" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid x:Name="CustomerLayout" ColumnSpacing="18" RowSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="280"/>
                    <ColumnDefinition x:Name="DetailColumn" Width="*"/>
                    <ColumnDefinition x:Name="OrderColumn" Width="282"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="DirectoryPanel" Spacing="8" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
                    <TextBox x:Name="SearchBox" PlaceholderText="Find a name, phone, or email…" AutomationProperties.Name="Find a customer" MaxLength="120" KeyDown="OnSearchKeyDown"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <CheckBox x:Name="IncludeInactive" Content="Show inactive"/>
                        <Button Content="Search" Click="OnSearch" Style="{StaticResource WorkspaceLink}"/>
                    </StackPanel>
                    <TextBlock x:Name="EmptyMessage" Text="No customers match. Clear the search or create a profile. Walk-ins can continue." Visibility="Collapsed"/>
                    <ListView x:Name="CustomersList" SelectionMode="Single" SelectionChanged="OnCustomerSelected" ContainerContentChanging="OnContainerContentChanging" MaxHeight="530" AutomationProperties.Name="Customer search results">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,8" ColumnSpacing="9" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" Background="{StaticResource ConsolePanelBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding FullName}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="16" Foreground="{StaticResource ConsoleInkBrush}"/>
                                        <TextBlock Text="{Binding Phone}" FontSize="7"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LoyaltyPointsBalance}" Style="{StaticResource ConsoleNumberStyle}" FontSize="16" HorizontalAlignment="Right"/>
                                        <TextBlock Text="points" FontSize="9" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <StackPanel x:Name="DetailPanel" Grid.Column="1" Spacing="14">
                    <Border BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,0,0,1" Padding="0,4,0,9">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="11">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="64" Height="64" Padding="4" Background="{StaticResource ConsoleFieldBrush}">
                                    <Border BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="1">
                                        <TextBlock x:Name="ProfileInitials" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="28" Foreground="{StaticResource ConsoleOnFieldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="DetailHeading" Text="Select a customer" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="30" Foreground="{StaticResource ConsoleInkBrush}"/>
                                    <TextBlock x:Name="ContactDetails" FontSize="8" IsTextSelectionEnabled="True"/>
                                </StackPanel>
                                <StackPanel x:Name="ProfileActions" Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="EditCustomerButton" Content="✎" AutomationProperties.Name="Edit customer profile" Click="OnEditCustomer" Style="{StaticResource WorkspaceLink}"/>
                                    <Button x:Name="DeactivateCustomerButton" Content="···" AutomationProperties.Name="Deactivate customer" Click="OnDeactivateCustomer" Style="{StaticResource WorkspaceLink}"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{StaticResource ConsolePanelBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Padding="10,7">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="LOYALTY BALANCE" Style="{StaticResource WorkspaceLabel}" FontSize="6"/>
                                    <TextBlock x:Name="BalanceText" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="24" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Grid x:Name="ProfileLower" ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="AddressColumn" Width="*"/>
                            <ColumnDefinition x:Name="HistoryColumn" Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="AddressPanel" Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Saved addresses" Style="{StaticResource WorkspaceHeading}"/>
                                <Button Grid.Column="1" x:Name="AddAddressButton" Content="+ Add" Click="OnAddAddress" Style="{StaticResource WorkspaceLink}"/>
                            </Grid>
                            <TextBlock x:Name="AddressesEmpty" Text="No saved addresses. Add one or use an order-only address."/>
                            <ListView x:Name="AddressesList" SelectionMode="None" MaxHeight="350" AutomationProperties.Name="Saved delivery addresses" ContainerContentChanging="OnContainerContentChanging">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ConsolePaperPanelStyle}" Padding="10" Margin="0,0,0,8">
                                            <StackPanel Spacing="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="16"/>
                                                        <TextBlock Text="{Binding StateDisplay}" Style="{StaticResource WorkspaceLabel}" FontSize="7"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="···" AutomationProperties.Name="Manage saved address" Style="{StaticResource WorkspaceLink}">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Edit address" Tag="{Binding Address}" Click="OnEditAddress" IsEnabled="{Binding IsActive}"/>
                                                            <MenuFlyoutItem Text="Make default" Tag="{Binding Address}" Click="OnDefaultAddress" IsEnabled="{Binding IsActive}"/>
                                                            <MenuFlyoutItem Text="Deactivate" Tag="{Binding Address}" Click="OnDeactivateAddress" IsEnabled="{Binding IsActive}"/>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="{Binding AddressLine}" FontSize="8"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Image Source="ms-appx:///Assets/Ornaments/stock-room.svg" Height="85" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                        </StackPanel>
                        <StackPanel x:Name="HistoryPanel" Grid.Column="1" Spacing="8">
                            <TextBlock Text="Loyalty ledger" Style="{StaticResource WorkspaceHeading}"/>
                            <TextBlock x:Name="HistoryEmpty" Text="No loyalty transactions yet."/>
                            <ListView x:Name="HistoryList" SelectionMode="None" MaxHeight="350" ContainerContentChanging="OnContainerContentChanging" AutomationProperties.Name="Loyalty transaction history">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,10" ColumnSpacing="8" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Type}"/>
                                                <TextBlock Text="{Binding CreatedAt}" FontSize="9"/>
                                                <TextBlock Text="{Binding OrderId}" FontSize="9" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Points}" Style="{StaticResource ConsoleNumberStyle}"/>
                                                <TextBlock Text="{Binding BalanceAfter}" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="HistoryPageText"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="PreviousButton" Content="Previous" Click="OnPreviousHistory"/>
                                <Button x:Name="NextButton" Content="Next" Click="OnNextHistory"/>
                            </StackPanel>
                            <controls:ConceptPattern Height="18"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="OrderPanel" Grid.Column="2" Spacing="16">
                    <Border RequestedTheme="Dark" Background="{StaticResource ConsoleFieldBrush}" Padding="16" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,2,0,0">
                        <StackPanel Spacing="6">
                            <controls:ConceptPattern Height="12"/>
                            <TextBlock Text="NEXT ORDER" Style="{StaticResource WorkspaceLabel}" Foreground="{StaticResource ConsoleOnFieldMutedBrush}"/>
                            <TextBlock x:Name="OrderSummary" Text="Walk-in — no profile required." FontFamily="{StaticResource ConsoleSerifFont}" FontSize="25" Foreground="{StaticResource ConsoleOnFieldBrush}" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="Dine-in, takeaway, or delivery. Points and saved addresses are available at the counter." FontSize="8" Foreground="{StaticResource ConsoleOnFieldMutedBrush}"/>
                            <StackPanel Spacing="4">
                                <CheckBox x:Name="UseSelectedProfile" Content="Use the selected profile" Foreground="{StaticResource ConsoleOnFieldBrush}" Checked="OnOrderOptionsChanged" Unchecked="OnOrderOptionsChanged"/>
                                <CheckBox x:Name="DeliveryOrder" Content="Delivery order" Foreground="{StaticResource ConsoleOnFieldBrush}" Checked="OnOrderOptionsChanged" Unchecked="OnOrderOptionsChanged"/>
                                <StackPanel x:Name="DeliveryFields" RequestedTheme="Light" Spacing="12" Visibility="Collapsed" Background="{StaticResource ConsoleGroundBrush}" Padding="8">
                                    <TextBox x:Name="RecipientName" Header="Recipient name" MaxLength="120"/>
                                    <TextBox x:Name="ContactNumber" Header="Contact number" MaxLength="30"/>
                                    <ComboBox x:Name="AddressChoice" Header="Delivery address" DisplayMemberPath="DisplayName" SelectionChanged="OnAddressChoiceChanged" MinHeight="48" HorizontalAlignment="Stretch"/>
                                    <TextBox x:Name="OrderAddress" Header="Order-only address" PlaceholderText="Used for this order without saving to a profile" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="SelectForOrderButton" Content="SET FOR NEXT ORDER" Click="OnSelectForOrder" Background="{StaticResource ConsoleGroundBrush}" HorizontalAlignment="Stretch"/>
                                <Button Content="CLEAR SELECTION · STAY WALK-IN" Click="OnWalkIn" Foreground="{StaticResource ConsoleOnFieldBrush}" Style="{StaticResource WorkspaceLink}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="8" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <TextBlock Text="Recent orders" Style="{StaticResource WorkspaceHeading}"/>
                        <TextBlock x:Name="OrdersEmpty" Text="No recent orders."/>
                        <ListView x:Name="OrdersList" SelectionMode="None" MaxHeight="280" ContainerContentChanging="OnContainerContentChanging" AutomationProperties.Name="Recent customer orders">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,10" ColumnSpacing="8" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Status}" FontSize="10"/>
                                            <TextBlock Text="{Binding CreatedAt}" FontSize="9"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Total}" Style="{StaticResource ConsoleNumberStyle}" FontSize="19"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
