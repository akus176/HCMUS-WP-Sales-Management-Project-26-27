<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:CoffeeShop.WinUI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoffeeShop.WinUI.Pages.OperationsPage" Background="{StaticResource ConsoleGroundBrush}" FontFamily="{StaticResource ConsoleSansFont}" Foreground="{StaticResource ConsoleInkBrush}" SizeChanged="OnBoardSizeChanged">
    <Page.Resources>
        <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="ConsoleRaisedGroundBrush" />
        <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="ConsoleRuleBrush" />
        <Style TargetType="Expander">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{StaticResource ConsoleRaisedGroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConsoleRuleBrush}" />
        </Style>
        <DataTemplate x:Key="BoardCardTemplate">
            <controls:ConceptNote Status="{Binding Status}" IsSelected="{Binding IsSelected}" Height="174">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Number}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding ChannelLabel}" Style="{StaticResource ConsoleLabelStyle}" VerticalAlignment="Center" FontSize="8" CharacterSpacing="0" />
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,1,0,0" />
                    <StackPanel Grid.Row="2" Spacing="2">
                        <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Items}" Style="{StaticResource ConsoleBodyStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="9" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="3" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding BalanceLabel}" Style="{StaticResource ConsoleLabelStyle}" FontSize="8" CharacterSpacing="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Tag="{Binding}" Click="OnCardAction" IsEnabled="{Binding ActionEnabled}" Style="{StaticResource BoardNoteAction}" AutomationProperties.Name="{Binding ActionName}" ToolTipService.ToolTip="{Binding ActionHint}" />
                    </Grid>
                </Grid>
            </controls:ConceptNote>
        </DataTemplate>
        <DataTemplate x:Key="TableOverviewTemplate">
            <Border MinWidth="160" MinHeight="88" Margin="0,0,10,10" Padding="12"
                    Background="{StaticResource ConsoleRaisedGroundBrush}"
                    BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1"
                    AutomationProperties.Name="{Binding AccessibilityLabel}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding TableNumber}" FontFamily="{StaticResource ConsoleSerifFont}"
                               FontSize="18" Foreground="{StaticResource ConsoleInkBrush}" />
                    <TextBlock Text="{Binding Availability}" Style="{StaticResource ConsoleLabelStyle}"
                               Foreground="{StaticResource ConsoleAccentTextBrush}" />
                    <TextBlock Text="{Binding Association}" Style="{StaticResource ConsoleBodyStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="OrderLineTemplate">
            <Grid Padding="0,9" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Quantity}" Foreground="{StaticResource ConsoleAccentTextBrush}" FontSize="14" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding ItemName}" Foreground="{StaticResource ConsoleInkBrush}" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource ConsoleMutedInkBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding TotalText}" Foreground="{StaticResource ConsoleInkBrush}" FontSize="14" />
            </Grid>
        </DataTemplate>
        <Style x:Key="BoardNoteItem" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,18,12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BoardNoteAction" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="CharacterSpacing" Value="0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleAccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConsoleAccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="BoardButton" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="BoardPrimaryButton" TargetType="Button" BasedOn="{StaticResource ConsolePrimaryButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource ConsolePagePadding}" Spacing="8" x:Name="BoardContent">
            <Grid x:Name="HeaderLayout" ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="HeaderActionColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Service board" Style="{StaticResource ConsolePageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource ConsoleBodyStyle}" FontSize="13" />
                </StackPanel>
                <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="OperatorBox" Header="Operator" PlaceholderText="Select operator" DisplayMemberPath="FullName" SelectionChanged="OnOperatorChanged" MinWidth="168" MinHeight="44" FontSize="14" AutomationProperties.Name="Service board operator" />
                    <Button x:Name="RefreshButton" Content="Refresh" Click="OnReload" Style="{StaticResource ConsoleButtonStyle}" MinHeight="44" FontSize="12" CharacterSpacing="0" VerticalAlignment="Bottom" AutomationProperties.Name="Refresh service board" />
                    <Button Content="Open Counter" Click="OnOpenCounter" Style="{StaticResource ConsolePrimaryButtonStyle}" FontSize="12" CharacterSpacing="0" VerticalAlignment="Bottom" />
                </StackPanel>
            </Grid>
            <Border BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,1,0,0" />
            <InfoBar x:Name="Status" IsClosable="False" IsOpen="False" />
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="EmptyText" Text="No active orders. Confirm a ticket at Counter to start service." Visibility="Collapsed" />
            <TextBlock x:Name="OperatorHint" Text="Choose an operator above to move tickets or record payments." FontSize="13" Foreground="{StaticResource ConsoleAccentTextBrush}" TextWrapping="Wrap" />
            <StackPanel x:Name="TableOverview" Spacing="6" AutomationProperties.Name="Dining table availability">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tables" Style="{StaticResource ConsoleSectionTitleStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="TableSummary" Grid.Column="1" Style="{StaticResource ConsoleLabelStyle}"
                               VerticalAlignment="Center" />
                </Grid>
                <ItemsControl x:Name="TableList" ItemTemplate="{StaticResource TableOverviewTemplate}"
                              AutomationProperties.Name="Dining tables and current availability">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="TableOverviewEmpty" Text="No dining tables are configured yet."
                           Visibility="Collapsed" Style="{StaticResource ConsoleBodyStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Grid x:Name="BoardLayout" ColumnSpacing="24" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NotesColumn" Width="*" />
                    <ColumnDefinition x:Name="RailColumn" Width="340" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="NotesLayout" ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="PreparingColumn" Width="*" />
                        <ColumnDefinition x:Name="ReadyColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="ConfirmedPanel" Spacing="6" Tag="confirmed" AllowDrop="True" DragOver="OnColumnDragOver" Drop="OnColumnDrop">
                        <Grid x:Name="ConfirmedHeader" Margin="3,0,3,0" MinHeight="44" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Confirmed" Style="{StaticResource ConsoleSectionTitleStyle}" VerticalAlignment="Center" FontSize="24" />
                            <TextBlock x:Name="ConfirmedCount" Grid.Column="1" Style="{StaticResource ConsoleNumberStyle}" VerticalAlignment="Center" FontSize="20" />
                        </Grid>
                        <ListView x:Name="ConfirmedList" ItemTemplate="{StaticResource BoardCardTemplate}" SelectionChanged="OnOrderChanged" AutomationProperties.Name="Confirmed orders" ItemContainerStyle="{StaticResource BoardNoteItem}" Padding="0" BorderThickness="0" Background="Transparent" CanDragItems="True" DragItemsStarting="OnDragItemsStarting" DragItemsCompleted="OnDragItemsCompleted" AutomationProperties.HelpText="Select a ticket for details. Use its action button or drag it to the next column." MinHeight="0" />
                        <TextBlock x:Name="ConfirmedEmpty" Text="No tickets here" Margin="3,8" FontSize="13" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="PreparingPanel" Grid.Column="1" Spacing="6" Tag="preparing" AllowDrop="True" DragOver="OnColumnDragOver" Drop="OnColumnDrop">
                        <Grid x:Name="PreparingHeader" Margin="3,0,3,0" MinHeight="44" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Preparing" Style="{StaticResource ConsoleSectionTitleStyle}" VerticalAlignment="Center" FontSize="24" />
                            <TextBlock x:Name="PreparingCount" Grid.Column="1" Style="{StaticResource ConsoleNumberStyle}" VerticalAlignment="Center" FontSize="20" />
                        </Grid>
                        <ListView x:Name="PreparingList" ItemTemplate="{StaticResource BoardCardTemplate}" SelectionChanged="OnOrderChanged" AutomationProperties.Name="Preparing orders" ItemContainerStyle="{StaticResource BoardNoteItem}" Padding="0" BorderThickness="0" Background="Transparent" CanDragItems="True" DragItemsStarting="OnDragItemsStarting" DragItemsCompleted="OnDragItemsCompleted" AutomationProperties.HelpText="Select a ticket for details. Use its action button or drag it to the next column." MinHeight="0" />
                        <TextBlock x:Name="PreparingEmpty" Text="No tickets here" Margin="3,8" FontSize="13" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="ReadyPanel" Grid.Column="2" Spacing="6" Tag="ready" AllowDrop="True" DragOver="OnColumnDragOver" Drop="OnColumnDrop">
                        <Grid x:Name="ReadyHeader" Margin="3,0,3,0" MinHeight="44" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ready" Style="{StaticResource ConsoleSectionTitleStyle}" VerticalAlignment="Center" FontSize="24" />
                            <TextBlock x:Name="ReadyCount" Grid.Column="1" Style="{StaticResource ConsoleNumberStyle}" VerticalAlignment="Center" FontSize="20" />
                        </Grid>
                        <ListView x:Name="ReadyList" ItemTemplate="{StaticResource BoardCardTemplate}" SelectionChanged="OnOrderChanged" AutomationProperties.Name="Ready orders" ItemContainerStyle="{StaticResource BoardNoteItem}" Padding="0" BorderThickness="0" Background="Transparent" CanDragItems="True" DragItemsStarting="OnDragItemsStarting" DragItemsCompleted="OnDragItemsCompleted" AutomationProperties.HelpText="Select a ticket for details. Use its action button or drag it to the next column." MinHeight="0" />
                        <TextBlock x:Name="ReadyEmpty" Text="No tickets here" Margin="3,8" FontSize="13" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="InspectorScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Background="{StaticResource ConsoleGroundBrush}">
                    <StackPanel x:Name="RailPanel" Spacing="12">
                        <Border BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1" Background="{StaticResource ConsoleRaisedGroundBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource ConsoleFieldBrush}" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,2,0,0" Padding="18,16">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="SelectedKicker" Text="TICKET DETAILS" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource ConsoleAccentLightBrush}" />
                                        <TextBlock x:Name="SelectedTitle" Text="Select a ticket" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="30" Foreground="{StaticResource ConsoleOnFieldBrush}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="SelectedState" FontSize="13" Foreground="{StaticResource ConsoleAccentLightBrush}" />
                                        <TextBlock x:Name="SelectedCustomer" FontSize="13" Foreground="{StaticResource ConsoleOnFieldBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="InspectorEmpty" Text="Select any note to see its items and next action." FontSize="14" Margin="18" TextWrapping="Wrap" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                <StackPanel x:Name="TicketBody" Padding="18,6,18,18" Spacing="12">
                                    <ListView x:Name="OrderLinesList" ItemTemplate="{StaticResource OrderLineTemplate}" Background="Transparent" Padding="0" IsHitTestVisible="False" SelectionMode="None" AutomationProperties.Name="Selected order lines" />
                                    <Grid BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Order total" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TotalText" Grid.Column="1" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="30" />
                                    </Grid>
                                    <TextBlock x:Name="BalanceText" FontSize="13" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ActionHint" FontSize="13" Foreground="{StaticResource ConsoleAccentTextBrush}" TextWrapping="Wrap" />
                                    <StackPanel Spacing="8">
                                        <Button x:Name="PrepareButton" Content="Start preparing" Click="OnPrepare" Style="{StaticResource BoardPrimaryButton}" />
                                        <Button x:Name="ReadyButton" Content="Mark ready" Click="OnReady" Style="{StaticResource BoardPrimaryButton}" />
                                        <Button x:Name="CompleteButton" Content="Complete order" Click="OnComplete" Style="{StaticResource BoardPrimaryButton}" />
                                        <Button x:Name="ReviewPaymentButton" Content="Collect payment" Click="OnShowPayment" Style="{StaticResource BoardPrimaryButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="TicketForms" Spacing="10">
                            <Expander x:Name="PaymentSection" Header="Payment" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12" Padding="0,4,0,8">
                                    <TextBlock x:Name="PaymentDueText" FontSize="14" TextWrapping="Wrap" />
                                    <ComboBox x:Name="PaymentMethodBox" Header="Payment method" SelectedIndex="0" HorizontalAlignment="Stretch" MinHeight="44" FontSize="14">
                                        <ComboBoxItem Tag="cash" Content="Cash" />
                                        <ComboBoxItem Tag="card" Content="Card" />
                                        <ComboBoxItem Tag="e_wallet" Content="E-wallet" />
                                    </ComboBox>
                                    <TextBox x:Name="PaymentAmountBox" Header="Amount to collect" MinHeight="44" FontSize="14" InputScope="Number" />
                                    <TextBox x:Name="PaymentReferenceBox" Header="Reference (optional)" FontSize="14" MinHeight="44" />
                                    <Button x:Name="PayButton" Content="Record payment" Click="OnPay" Style="{StaticResource BoardPrimaryButton}" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="DiscountSection" Header="Discount requests" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10" Padding="0,4,0,8">
                                    <ListView x:Name="DiscountList" DisplayMemberPath="Label" MaxHeight="160" SelectionMode="Single" SelectionChanged="OnDiscountChanged" AutomationProperties.Name="Pending discount requests" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ApproveButton" Content="Approve" Click="OnApprove" Style="{StaticResource BoardButton}" />
                                        <Button x:Name="RejectButton" Grid.Column="1" Content="Reject" Click="OnReject" Style="{StaticResource BoardButton}" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="DeliverySection" Header="Delivery" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12" Padding="0,4,0,8">
                                    <TextBlock x:Name="DeliverySummary" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DeliveryAddress" FontSize="14" TextWrapping="Wrap" />
                                    <ComboBox x:Name="DeliveryStaffBox" Header="Delivery staff" DisplayMemberPath="FullName" SelectionChanged="OnDeliveryStaffChanged" HorizontalAlignment="Stretch" MinHeight="44" FontSize="14" />
                                    <Button x:Name="AssignButton" Content="Assign delivery" Click="OnAssign" Style="{StaticResource BoardButton}" />
                                    <Button x:Name="OutButton" Content="Start delivery" Click="OnOut" Style="{StaticResource BoardPrimaryButton}" />
                                    <Button x:Name="DeliveredButton" Content="Mark delivered" Click="OnDelivered" Style="{StaticResource BoardPrimaryButton}" />
                                    <StackPanel x:Name="DeliveryFailureForm" Spacing="10">
                                        <TextBox x:Name="FailureReasonBox" Header="Reason delivery failed" FontSize="14" MinHeight="44" />
                                        <Button x:Name="FailButton" Content="Mark delivery failed" Click="OnFail" Style="{StaticResource BoardButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="CancelSection" Header="Cancel order" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12" Padding="0,4,0,8">
                                    <TextBlock Text="Give a reason before cancelling this ticket." FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                    <TextBox x:Name="CancelReasonBox" Header="Cancellation reason" FontSize="14" MinHeight="44" AcceptsReturn="True" TextWrapping="Wrap" />
                                    <Button x:Name="CancelButton" Content="Cancel this order" Click="OnCancel" Style="{StaticResource BoardButton}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" />
            <StackPanel x:Name="TableOverview" Spacing="6" Padding="0,12,0,0" AutomationProperties.Name="Dining table availability">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tables" Style="{StaticResource ConsoleSectionTitleStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="TableSummary" Grid.Column="1" Style="{StaticResource ConsoleLabelStyle}"
                               VerticalAlignment="Center" />
                </Grid>
                <ItemsControl x:Name="TableList" ItemTemplate="{StaticResource TableOverviewTemplate}"
                              AutomationProperties.Name="Dining tables and current availability">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="TableOverviewEmpty" Text="No dining tables are configured yet."
                           Visibility="Collapsed" Style="{StaticResource ConsoleBodyStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
