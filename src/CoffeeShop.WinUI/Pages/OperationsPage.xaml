<Page x:Class="CoffeeShop.WinUI.Pages.OperationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoffeeShop.WinUI.Controls"
    Background="{StaticResource ConsoleGroundBrush}"
    FontFamily="{StaticResource ConsoleSansFont}" Foreground="{StaticResource ConsoleInkBrush}">
    <Page.Resources>
        <DataTemplate x:Key="BoardCardTemplate">
            <controls:ConceptNote Status="{Binding Status}" IsSelected="{Binding IsSelected}" Height="174">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Number}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="18"/>
                        <TextBlock Grid.Column="1" Text="{Binding ChannelLabel}" Style="{StaticResource ConsoleLabelStyle}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,1,0,0"/>
                    <StackPanel Grid.Row="2" Spacing="2">
                        <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="18" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Items}" Style="{StaticResource ConsoleBodyStyle}" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid Grid.Row="3" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Footer}" Style="{StaticResource ConsoleLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ActionLabel}" Style="{StaticResource ConsoleLabelStyle}" Foreground="{StaticResource ConsoleAccentTextBrush}"/>
                    </Grid>
                </Grid>
            </controls:ConceptNote>
        </DataTemplate>
        <DataTemplate x:Key="OrderLineTemplate">
            <Grid Padding="0,9" BorderBrush="{StaticResource ConsoleFieldLineBrush}" BorderThickness="0,0,0,1" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Quantity}" Foreground="{StaticResource ConsoleAccentLightBrush}"/>
                <StackPanel Grid.Column="1"><TextBlock Text="{Binding ItemName}" Foreground="{StaticResource ConsoleOnFieldBrush}"/><TextBlock Text="{Binding SizeName}" Foreground="{StaticResource ConsoleOnFieldMutedBrush}" FontSize="10"/></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Total}" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,22,32,28" Spacing="16">
            <Grid MinHeight="112" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="●  SERVICE  /  LIVE FLOOR" Style="{StaticResource ConsoleLabelStyle}" Foreground="{StaticResource ConsoleAccentTextBrush}"/>
                    <TextBlock Text="Service board" Style="{StaticResource ConsolePageTitleStyle}"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource ConsoleBodyStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="REFRESH" Click="OnReload" Style="{StaticResource ConsoleButtonStyle}" AutomationProperties.Name="Refresh service board"/>
                    <Button Content="OPEN COUNTER" Click="OnOpenCounter" Style="{StaticResource ConsolePrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
            <Border BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,1,0,0"/>
            <InfoBar x:Name="Status" IsClosable="False" IsOpen="False"/>
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyText" Text="No active orders. Confirm a ticket at Counter to start service." Visibility="Collapsed"/>
            <Grid x:Name="BoardLayout" ColumnSpacing="24" RowSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="NotesColumn" Width="*"/><ColumnDefinition x:Name="RailColumn" Width="340"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups><VisualStateGroup>
                    <VisualState x:Name="Expanded"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1008"/></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="NotesColumn.Width" Value="*"/><Setter Target="RailColumn.Width" Value="340"/><Setter Target="RailPanel.(Grid.Column)" Value="1"/><Setter Target="RailPanel.(Grid.Row)" Value="0"/></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Compact"><VisualState.Setters><Setter Target="NotesColumn.Width" Value="*"/><Setter Target="RailColumn.Width" Value="0"/><Setter Target="RailPanel.(Grid.Column)" Value="0"/><Setter Target="RailPanel.(Grid.Row)" Value="1"/></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateManager.VisualStateGroups>
                <Grid x:Name="NotesLayout" ColumnSpacing="18" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PreparingColumn" Width="*"/><ColumnDefinition x:Name="ReadyColumn" Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <VisualStateManager.VisualStateGroups><VisualStateGroup>
                        <VisualState x:Name="NotesExpanded"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1008"/></VisualState.StateTriggers>
                            <VisualState.Setters><Setter Target="PreparingColumn.Width" Value="*"/><Setter Target="ReadyColumn.Width" Value="*"/><Setter Target="PreparingPanel.(Grid.Column)" Value="1"/><Setter Target="PreparingPanel.(Grid.Row)" Value="0"/><Setter Target="ReadyPanel.(Grid.Column)" Value="2"/><Setter Target="ReadyPanel.(Grid.Row)" Value="0"/></VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="NotesCompact"><VisualState.Setters><Setter Target="PreparingColumn.Width" Value="0"/><Setter Target="ReadyColumn.Width" Value="0"/><Setter Target="PreparingPanel.(Grid.Column)" Value="0"/><Setter Target="PreparingPanel.(Grid.Row)" Value="1"/><Setter Target="ReadyPanel.(Grid.Column)" Value="0"/><Setter Target="ReadyPanel.(Grid.Row)" Value="2"/></VisualState.Setters></VisualState>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <StackPanel x:Name="ConfirmedPanel" Spacing="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="· Confirmed" Style="{StaticResource ConsoleSectionTitleStyle}"/><TextBlock x:Name="ConfirmedCount" Grid.Column="1" Style="{StaticResource ConsoleNumberStyle}"/></Grid><ListView x:Name="ConfirmedList" ItemTemplate="{StaticResource BoardCardTemplate}" SelectionChanged="OnOrderChanged" AutomationProperties.Name="Confirmed orders"/></StackPanel>
                    <StackPanel x:Name="PreparingPanel" Grid.Column="1" Spacing="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="· Preparing" Style="{StaticResource ConsoleSectionTitleStyle}"/><TextBlock x:Name="PreparingCount" Grid.Column="1" Style="{StaticResource ConsoleNumberStyle}"/></Grid><ListView x:Name="PreparingList" ItemTemplate="{StaticResource BoardCardTemplate}" SelectionChanged="OnOrderChanged" AutomationProperties.Name="Preparing orders"/></StackPanel>
                    <StackPanel x:Name="ReadyPanel" Grid.Column="2" Spacing="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="· Ready" Style="{StaticResource ConsoleSectionTitleStyle}"/><TextBlock x:Name="ReadyCount" Grid.Column="1" Style="{StaticResource ConsoleNumberStyle}"/></Grid><ListView x:Name="ReadyList" ItemTemplate="{StaticResource BoardCardTemplate}" SelectionChanged="OnOrderChanged" AutomationProperties.Name="Ready orders"/></StackPanel>
                </Grid>
                <StackPanel x:Name="RailPanel" Grid.Column="1" Spacing="14">
                    <Border Background="{StaticResource ConsoleFieldBrush}" Padding="18" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,2,0,0">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SelectedKicker" Text="SELECT A TICKET" Style="{StaticResource ConsoleLabelStyle}" Foreground="{StaticResource ConsoleAccentLightBrush}"/>
                            <TextBlock x:Name="SelectedTitle" Text="No ticket selected" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="30" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
                            <TextBlock x:Name="SelectedState" Foreground="{StaticResource ConsoleAccentLightBrush}"/>
                            <TextBlock x:Name="SelectedCustomer" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
                            <ListView x:Name="OrderLinesList" ItemTemplate="{StaticResource OrderLineTemplate}" Background="Transparent" IsHitTestVisible="False" AutomationProperties.Name="Selected order lines"/>
                            <Grid BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="TOTAL" Style="{StaticResource ConsoleLabelStyle}" Foreground="{StaticResource ConsoleOnFieldMutedBrush}"/><TextBlock x:Name="TotalText" Grid.Column="1" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="27" Foreground="{StaticResource ConsoleOnFieldBrush}"/></Grid>
                            <TextBlock x:Name="BalanceText" Foreground="{StaticResource ConsoleOnFieldMutedBrush}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="PrepareButton" Content="START" Click="OnPrepare" Style="{StaticResource ConsolePrimaryButtonStyle}"/><Button x:Name="ReadyButton" Content="MARK READY" Click="OnReady" Style="{StaticResource ConsolePrimaryButtonStyle}"/><Button x:Name="CompleteButton" Content="COMPLETE" Click="OnComplete" Style="{StaticResource ConsolePrimaryButtonStyle}"/></StackPanel>
                            <Button x:Name="CancelButton" Content="CANCEL ORDER" Click="OnCancel" Style="{StaticResource ConsoleButtonStyle}" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
                        </StackPanel>
                    </Border>
                    <Expander Header="Payment and discount"><StackPanel Spacing="8" Padding="8">
                        <ComboBox x:Name="PaymentMethodBox" Header="Payment method" SelectedIndex="0"><ComboBoxItem Tag="cash" Content="Cash"/><ComboBoxItem Tag="card" Content="Card"/><ComboBoxItem Tag="e_wallet" Content="E-wallet"/></ComboBox>
                        <TextBox x:Name="PaymentAmountBox" Header="Amount"/><TextBox x:Name="PaymentReferenceBox" Header="Reference"/><Button x:Name="PayButton" Content="RECORD PAYMENT" Click="OnPay" Style="{StaticResource ConsoleButtonStyle}"/>
                        <ListView x:Name="DiscountList" MaxHeight="110" SelectionMode="Single" AutomationProperties.Name="Pending discount requests"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ApproveButton" Content="APPROVE" Click="OnApprove" Style="{StaticResource ConsoleButtonStyle}"/><Button x:Name="RejectButton" Content="REJECT" Click="OnReject" Style="{StaticResource ConsoleButtonStyle}"/></StackPanel>
                    </StackPanel></Expander>
                    <Expander Header="Cancellation and delivery"><StackPanel Spacing="8" Padding="8">
                        <TextBox x:Name="CancelReasonBox" Header="Cancellation reason"/>
                        <ComboBox x:Name="DeliveryStaffBox" Header="Delivery staff" DisplayMemberPath="FullName" SelectionChanged="OnDeliveryStaffChanged"/><Button x:Name="AssignButton" Content="ASSIGN DELIVERY" Click="OnAssign" Style="{StaticResource ConsoleButtonStyle}"/>
                        <Button x:Name="OutButton" Content="START DELIVERY" Click="OnOut" Style="{StaticResource ConsoleButtonStyle}"/><Button x:Name="DeliveredButton" Content="MARK DELIVERED" Click="OnDelivered" Style="{StaticResource ConsoleButtonStyle}"/>
                        <TextBox x:Name="FailureReasonBox" Header="Failure reason"/><Button x:Name="FailButton" Content="MARK FAILED" Click="OnFail" Style="{StaticResource ConsoleButtonStyle}"/>
                    </StackPanel></Expander>
                    <Border BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><StackPanel Spacing="8"><TextBlock Text="Tables" Style="{StaticResource ConsoleSectionTitleStyle}"/><ItemsControl x:Name="TablesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="72" MinHeight="50" Margin="2" Background="{StaticResource ConsolePanelBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1"><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding TableNumber}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="{Binding Seats}" Style="{StaticResource ConsoleLabelStyle}" HorizontalAlignment="Center"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
