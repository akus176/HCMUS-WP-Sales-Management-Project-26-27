<ContentDialog
    x:Class="CoffeeShop.WinUI.Pages.IngredientDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonClick="OnPrimaryClick">
    <StackPanel Spacing="12"
            MinWidth="360">
        <TextBox x:Name="NameBox"
                Header="Name"
                PlaceholderText="e.g. Coffee beans"/>
        <ComboBox x:Name="UnitBox" Header="Stock unit" PlaceholderText="Choose a unit" HorizontalAlignment="Stretch" SelectionChanged="OnUnitChanged">
            <ComboBoxItem Content="Grams (g)" Tag="g" />
            <ComboBoxItem Content="Kilograms (kg)" Tag="kg" />
            <ComboBoxItem Content="Milliliters (ml)" Tag="ml" />
            <ComboBoxItem Content="Liters (l)" Tag="l" />
            <ComboBoxItem Content="Pieces (pcs)" Tag="pcs" />
        </ComboBox>
        <TextBox x:Name="BalanceBox"
                Header="Starting stock"
                Text="0"/>
        <TextBox x:Name="ThresholdBox"
                Header="Low-stock threshold"
                Text="0"/>
    </StackPanel>
</ContentDialog>
