<Page
    x:Class="CoffeeShop.WinUI.Pages.PosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource SketchBodyFontFamily}"
    Foreground="{StaticResource SketchForegroundBrush}">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobbly}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource SketchBorderBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="CornerRadius" Value="{StaticResource SketchCornerRadiusWobbly}"/>
            <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="{StaticResource SketchBodyFontFamily}"/>
        </Style>
    </Page.Resources>
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="A fresh ticket" FontFamily="{StaticResource SketchHeadingFontFamily}" FontSize="36"/>
            <TextBlock Text="Pick a cup. Review the ticket. Send it to the bar." TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>
            <InfoBar x:Name="Status" IsOpen="True" IsClosable="False"/>
            <Button x:Name="ReloadButton" Content="Reload menu and ticket" Click="OnReload" HorizontalAlignment="Left"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="Layout" RowSpacing="24" ColumnSpacing="24" Padding="0,8,8,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MenuColumn" Width="*"/>
                    <ColumnDefinition x:Name="TicketColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Expanded">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1008"/></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MenuColumn.Width" Value="*"/>
                                <Setter Target="TicketColumn.Width" Value="*"/>
                                <Setter Target="TicketPanel.(Grid.Column)" Value="1"/>
                                <Setter Target="TicketPanel.(Grid.Row)" Value="0"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Compact"/>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <StackPanel Spacing="16">
                    <ComboBox x:Name="OperatorBox" Header="Operator (midterm actor selection, not a login)" DisplayMemberPath="FullName" SelectionChanged="OnOperatorChanged"/>
                    <UserControl x:Name="EntryPanel"><StackPanel Spacing="16">
                        <ComboBox x:Name="ChannelBox" Header="Order channel" SelectionChanged="OnChannelChanged">
                            <ComboBoxItem Content="Dine-in" Tag="dine_in"/>
                            <ComboBoxItem Content="Takeaway" Tag="takeaway"/>
                            <ComboBoxItem Content="Delivery" Tag="delivery"/>
                        </ComboBox>
                        <ComboBox x:Name="TableBox" Header="Available table (rechecked at confirmation)" DisplayMemberPath="TableNumber" SelectionChanged="OnTableChanged"/>
                        <TextBlock x:Name="CustomerText" TextWrapping="Wrap"/>
                        <Button Content="Choose customer / saved delivery address" Click="OnChooseCustomer"/>
                        <Button Content="Use selection from Customers" Click="OnUseCustomer"/>
                        <Button Content="Continue as walk-in" Click="OnWalkIn"/>
                        <StackPanel x:Name="DeliveryPanel" Spacing="12" Visibility="Collapsed">
                            <TextBox x:Name="RecipientBox" Header="Delivery recipient" MaxLength="120"/>
                            <TextBox x:Name="ContactBox" Header="Contact number" MaxLength="30"/>
                            <CheckBox x:Name="SavedAddressCheck" Content="Use attached customer's saved address" MinHeight="48" Checked="OnAddressModeChanged" Unchecked="OnAddressModeChanged"/>
                            <TextBlock x:Name="SavedAddressText" TextWrapping="Wrap"/>
                            <TextBox x:Name="AddressBox" Header="Order-only delivery address" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBox x:Name="SearchBox" Header="Find a drink" MaxLength="120"/>
                        <Button Content="Search menu" Click="OnSearch"/>
                        <TextBlock x:Name="EmptyText" Text="No available drinks match. Clear the search or check active categories, drinks and sizes in Menu and Recipes." TextWrapping="Wrap" Visibility="Collapsed"/>
                        <ComboBox x:Name="DrinkBox" Header="Drink" DisplayMemberPath="Name" SelectionChanged="OnDrinkChanged"/>
                        <ComboBox x:Name="SizeBox" Header="Size" DisplayMemberPath="SizeName" SelectionChanged="OnSizeChanged"/>
                        <TextBlock x:Name="SizePriceText" TextWrapping="Wrap"/>
                        <TextBox x:Name="QuantityBox" Header="Quantity (whole drinks)" Text="1" MaxLength="10"/>
                        <TextBlock Text="Optional toppings: one of each per drink" TextWrapping="Wrap"/>
                        <ListView x:Name="AddonsList" SelectionMode="Multiple" MaxHeight="220" DisplayMemberPath="Name" AutomationProperties.Name="Compatible add-ons"/>
                        <TextBlock x:Name="AddonPricesText" TextWrapping="Wrap"/>
                        <Button Content="Add drink to ticket" Click="OnAddLine"/>
                        <ListView x:Name="CartList" SelectionMode="Single" MaxHeight="300" DisplayMemberPath="Description" AutomationProperties.Name="Unsaved ticket lines"/>
                        <Button Content="Remove selected line" Click="OnRemoveLine"/>
                        <Button x:Name="SaveButton" Content="Save draft and review exact totals" Click="OnSaveDraft"/>
                    </StackPanel></UserControl>
                </StackPanel>
                <Grid x:Name="TicketPanel" Grid.Row="1">
                    <Border Background="{StaticResource SketchBorderBrush}" CornerRadius="{StaticResource SketchCornerRadiusWobblyMd}" Translation="4,4,0"/>
                    <Border Background="{StaticResource SketchPostItBrush}" BorderBrush="{StaticResource SketchBorderBrush}" BorderThickness="2" CornerRadius="{StaticResource SketchCornerRadiusWobblyMd}" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="The order ticket" FontSize="28" FontFamily="{StaticResource SketchHeadingFontFamily}"/>
                            <TextBlock x:Name="TicketIdText" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TicketText" Text="Your saved snapshots and exact total will appear here." TextWrapping="Wrap" FontSize="20" IsTextSelectionEnabled="True"/>
                            <UserControl x:Name="DiscountPanel" IsEnabled="False"><StackPanel Spacing="12">
                                <TextBox x:Name="LoyaltyPointsBox" Header="Loyalty points to redeem (attached customer)"/>
                                <Button Content="Redeem loyalty points" Click="OnRedeemLoyalty"/>
                                <TextBlock Text="Request a discount (manager approval required)" TextWrapping="Wrap" FontSize="22"/>
                                <ComboBox x:Name="DiscountTypeBox" Header="Discount type" SelectedIndex="0">
                                    <ComboBoxItem Content="Fixed amount" Tag="fixed"/>
                                    <ComboBoxItem Content="Percentage" Tag="percentage"/>
                                </ComboBox>
                                <TextBox x:Name="DiscountValueBox" Header="Value"/>
                                <TextBox x:Name="DiscountReasonBox" Header="Reason" AcceptsReturn="True" TextWrapping="Wrap"/>
                                <Button Content="Request discount" Click="OnRequestDiscount"/>
                                <TextBlock Text="Pending requests do not reduce the total. Reload after manager approval and review the new total." TextWrapping="Wrap"/>
                            </StackPanel></UserControl>
                            <Button x:Name="ConfirmButton" Content="Confirm reviewed order" Click="OnConfirm" IsEnabled="False" Background="{StaticResource SketchSecondaryAccentBrush}" Foreground="{StaticResource SketchBackgroundBrush}"/>
                            <Button x:Name="NewButton" Content="Start a new ticket" Click="OnNewTicket"/>
                            <TextBox x:Name="OpenIdBox" Header="Reopen saved ticket by order ID"/>
                            <Button x:Name="OpenButton" Content="Open saved ticket" Click="OnOpen"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
