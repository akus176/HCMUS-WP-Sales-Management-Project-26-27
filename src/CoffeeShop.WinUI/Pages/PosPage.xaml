<Page x:Class="CoffeeShop.WinUI.Pages.PosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ConsoleGroundBrush}"
    FontFamily="{StaticResource ConsoleSansFont}" Foreground="{StaticResource ConsoleInkBrush}">
    <Page.Resources>
        <DataTemplate x:Key="MenuCardTemplate">
            <Grid Width="184" Height="174" Margin="0,0,10,12" RowSpacing="3">
                <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1"><Image Source="{Binding Photo}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw"/></Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="18" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="2" Text="{Binding Category}" Style="{StaticResource ConsoleLabelStyle}"/>
                <Grid Grid.Row="3" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Price}" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="＋" Foreground="{StaticResource ConsoleAccentTextBrush}"/>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CartLineTemplate">
            <Grid Padding="0,9" BorderBrush="{StaticResource ConsoleFieldLineBrush}" BorderThickness="0,0,0,1" ColumnSpacing="5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="−" Click="OnDecreaseLine" Tag="{Binding}" Width="48" Height="48" AutomationProperties.Name="Decrease line quantity" Style="{StaticResource ConsoleButtonStyle}" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
                <Button Grid.Column="1" Content="+" Click="OnIncreaseLine" Tag="{Binding}" Width="48" Height="48" AutomationProperties.Name="Increase line quantity" Style="{StaticResource ConsoleButtonStyle}" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{StaticResource ConsoleOnFieldBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SavedLineTemplate">
            <Grid Padding="0,8" BorderBrush="{StaticResource ConsoleFieldLineBrush}" BorderThickness="0,0,0,1" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding ItemName}" Foreground="{StaticResource ConsoleOnFieldBrush}"/><TextBlock Text="{Binding SizeName}" Foreground="{StaticResource ConsoleOnFieldMutedBrush}" FontSize="10"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Total}" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,22,32,28" Spacing="16">
            <Grid x:Name="HeaderLayout" MinHeight="112" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="HeaderActionColumn" Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups><VisualStateGroup>
                    <VisualState x:Name="HeaderWide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="641"/></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="HeaderActionColumn.Width" Value="Auto"/><Setter Target="NewButton.(Grid.Column)" Value="1"/><Setter Target="NewButton.(Grid.Row)" Value="0"/></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="HeaderNarrow"><VisualState.Setters><Setter Target="HeaderActionColumn.Width" Value="0"/><Setter Target="NewButton.(Grid.Column)" Value="0"/><Setter Target="NewButton.(Grid.Row)" Value="1"/></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateManager.VisualStateGroups>
                <StackPanel Spacing="3">
                    <TextBlock Text="●  SERVICE  /  COUNTER" Style="{StaticResource ConsoleLabelStyle}" Foreground="{StaticResource ConsoleAccentTextBrush}"/>
                    <TextBlock Text="Counter" Style="{StaticResource ConsolePageTitleStyle}"/>
                    <TextBlock Text="Choose a drink, review the ticket, and send the order to service." Style="{StaticResource ConsoleBodyStyle}"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="NewButton" Content="＋  NEW TICKET" Click="OnNewTicket" Style="{StaticResource ConsolePrimaryButtonStyle}" VerticalAlignment="Center"/>
            </Grid>
            <Border BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,1,0,0"/>
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>
            <InfoBar x:Name="Status" IsClosable="False" IsOpen="False"/>
            <Grid x:Name="Layout" ColumnSpacing="24" RowSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="MenuColumn" Width="*"/><ColumnDefinition x:Name="TicketColumn" Width="350"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups><VisualStateGroup>
                    <VisualState x:Name="Expanded"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1008"/></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="MenuColumn.Width" Value="*"/><Setter Target="TicketColumn.Width" Value="350"/><Setter Target="TicketPanel.(Grid.Column)" Value="1"/><Setter Target="TicketPanel.(Grid.Row)" Value="0"/></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Compact"><VisualState.Setters><Setter Target="MenuColumn.Width" Value="*"/><Setter Target="TicketColumn.Width" Value="0"/><Setter Target="TicketPanel.(Grid.Column)" Value="0"/><Setter Target="TicketPanel.(Grid.Row)" Value="1"/></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateManager.VisualStateGroups>
                <StackPanel x:Name="MenuPanel" Spacing="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CategoryList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding}" Click="OnCategoryClick" Style="{StaticResource ConsoleButtonStyle}" Margin="0,0,4,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Header="Find a drink" MaxLength="120" Style="{StaticResource ConsoleFieldStyle}" KeyDown="OnSearchKeyDown"/>
                        <Button Grid.Column="1" Content="SEARCH" Click="OnSearch" Style="{StaticResource ConsoleButtonStyle}" VerticalAlignment="Bottom"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="MenuHeading" Text="All drinks" Style="{StaticResource ConsoleSectionTitleStyle}"/>
                        <TextBlock x:Name="MenuCount" Grid.Column="1" Style="{StaticResource ConsoleLabelStyle}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="EmptyText" Text="No available drinks match. Clear the search or choose another category." Visibility="Collapsed" TextWrapping="Wrap"/>
                    <GridView x:Name="MenuGrid" ItemTemplate="{StaticResource MenuCardTemplate}" SelectionChanged="OnMenuCardChanged" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Available menu items">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid ItemWidth="194" ItemHeight="190" Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
                    </GridView>
                    <Expander x:Name="CustomizationPanel" Header="Choose size and add-ons for the selected drink" IsExpanded="False">
                        <UserControl x:Name="EntryPanel"><StackPanel Spacing="10" Padding="8">
                            <ComboBox x:Name="DrinkBox" Header="Selected drink" DisplayMemberPath="Name" SelectionChanged="OnDrinkChanged"/>
                            <ComboBox x:Name="SizeBox" Header="Size" DisplayMemberPath="SizeName" SelectionChanged="OnSizeChanged"/>
                            <TextBlock x:Name="SizePriceText" Style="{StaticResource ConsoleBodyStyle}"/>
                            <TextBox x:Name="QuantityBox" Header="Quantity" Text="1" MaxLength="10" Style="{StaticResource ConsoleFieldStyle}"/>
                            <ListView x:Name="AddonsList" Header="Compatible add-ons" SelectionMode="Multiple" MaxHeight="180" DisplayMemberPath="Name" AutomationProperties.Name="Compatible add-ons"/>
                            <TextBlock x:Name="AddonPricesText" Style="{StaticResource ConsoleBodyStyle}"/>
                            <Button Content="ADD TO TICKET" Click="OnAddLine" Style="{StaticResource ConsolePrimaryButtonStyle}"/>
                        </StackPanel></UserControl>
                    </Expander>
                    <Button x:Name="ReloadButton" Content="RELOAD MENU AND TICKET" Click="OnReload" Style="{StaticResource ConsoleButtonStyle}" HorizontalAlignment="Left"/>
                </StackPanel>
                <Border x:Name="TicketPanel" Grid.Column="1" Background="{StaticResource ConsoleFieldBrush}" Padding="18" BorderBrush="{StaticResource ConsoleAccentBrush}" BorderThickness="0,2,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="ACTIVE TICKET" Style="{StaticResource ConsoleLabelStyle}" Foreground="{StaticResource ConsoleAccentLightBrush}"/>
                        <TextBlock x:Name="TicketHeading" Text="New ticket" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="29" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
                        <TextBlock x:Name="TicketIdText" Foreground="{StaticResource ConsoleOnFieldMutedBrush}" FontSize="10" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <ComboBox x:Name="OperatorBox" Header="Operator" DisplayMemberPath="FullName" SelectionChanged="OnOperatorChanged"/>
                        <UserControl x:Name="TicketEntryPanel"><StackPanel Spacing="9">
                            <ComboBox x:Name="ChannelBox" Header="Order channel" SelectionChanged="OnChannelChanged"><ComboBoxItem Content="Dine-in" Tag="dine_in"/><ComboBoxItem Content="Takeaway" Tag="takeaway"/><ComboBoxItem Content="Delivery" Tag="delivery"/></ComboBox>
                            <ComboBox x:Name="TableBox" Header="Available table" DisplayMemberPath="TableNumber" SelectionChanged="OnTableChanged"/>
                            <TextBlock x:Name="CustomerText" Foreground="{StaticResource ConsoleOnFieldBrush}" TextWrapping="Wrap"/>
                            <Button Content="CHOOSE CUSTOMER / ADDRESS" Click="OnChooseCustomer" Style="{StaticResource ConsoleButtonStyle}" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
                            <Button Content="USE CUSTOMER SELECTION" Click="OnUseCustomer" Style="{StaticResource ConsoleButtonStyle}" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
                            <Button Content="CONTINUE AS WALK-IN" Click="OnWalkIn" Style="{StaticResource ConsoleButtonStyle}" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
                            <StackPanel x:Name="DeliveryPanel" Spacing="8" Visibility="Collapsed">
                                <TextBox x:Name="RecipientBox" Header="Delivery recipient" MaxLength="120"/><TextBox x:Name="ContactBox" Header="Contact number" MaxLength="30"/>
                                <CheckBox x:Name="SavedAddressCheck" Content="Use saved address" MinHeight="48" Checked="OnAddressModeChanged" Unchecked="OnAddressModeChanged"/>
                                <TextBlock x:Name="SavedAddressText" Foreground="{StaticResource ConsoleOnFieldMutedBrush}" TextWrapping="Wrap"/>
                                <TextBox x:Name="AddressBox" Header="Order-only delivery address" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel></UserControl>
                        <TextBlock Text="ORDER LINES" Style="{StaticResource ConsoleLabelStyle}" Foreground="{StaticResource ConsoleAccentLightBrush}"/>
                        <ListView x:Name="CartList" ItemTemplate="{StaticResource CartLineTemplate}" MaxHeight="260" SelectionChanged="OnCartSelectionChanged" AutomationProperties.Name="Unsaved ticket lines"/>
                        <ListView x:Name="SavedLinesList" ItemTemplate="{StaticResource SavedLineTemplate}" MaxHeight="260" AutomationProperties.Name="Saved ticket lines" Visibility="Collapsed"/>
                        <Button x:Name="RemoveButton" Content="REMOVE SELECTED LINE" Click="OnRemoveLine" Style="{StaticResource ConsoleButtonStyle}" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
                        <TextBlock x:Name="TicketText" Foreground="{StaticResource ConsoleOnFieldBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <Expander Header="Loyalty and discount"><UserControl x:Name="DiscountPanel"><StackPanel Spacing="8" Padding="8">
                            <TextBox x:Name="LoyaltyPointsBox" Header="Loyalty points to redeem"/><Button Content="REDEEM POINTS" Click="OnRedeemLoyalty" Style="{StaticResource ConsoleButtonStyle}"/>
                            <ComboBox x:Name="DiscountTypeBox" Header="Discount type" SelectedIndex="0"><ComboBoxItem Content="Fixed amount" Tag="fixed"/><ComboBoxItem Content="Percentage" Tag="percentage"/></ComboBox>
                            <TextBox x:Name="DiscountValueBox" Header="Value"/><TextBox x:Name="DiscountReasonBox" Header="Reason" AcceptsReturn="True" TextWrapping="Wrap"/>
                            <Button Content="REQUEST DISCOUNT" Click="OnRequestDiscount" Style="{StaticResource ConsoleButtonStyle}"/>
                            <TextBlock Text="Pending requests do not reduce the total. Reload after manager approval." TextWrapping="Wrap"/>
                        </StackPanel></UserControl></Expander>
                        <Button x:Name="SaveButton" Content="SAVE DRAFT AND REVIEW TOTAL" Click="OnSaveDraft" Style="{StaticResource ConsoleButtonStyle}" Foreground="{StaticResource ConsoleOnFieldBrush}"/>
                        <Button x:Name="ConfirmButton" Content="CONFIRM REVIEWED ORDER" Click="OnConfirm" Style="{StaticResource ConsolePrimaryButtonStyle}" Background="{StaticResource ConsoleOnFieldBrush}" Foreground="{StaticResource ConsoleInkBrush}" IsEnabled="False"/>
                        <Button x:Name="ServiceBoardButton" Content="CONTINUE IN SERVICE BOARD" Click="OnServiceBoard" Style="{StaticResource ConsoleButtonStyle}" Foreground="{StaticResource ConsoleOnFieldBrush}" Visibility="Collapsed"/>
                        <Expander Header="Reopen saved ticket"><StackPanel Spacing="8" Padding="8"><TextBox x:Name="OpenIdBox" Header="Order ID"/><Button x:Name="OpenButton" Content="OPEN SAVED TICKET" Click="OnOpen" Style="{StaticResource ConsoleButtonStyle}"/></StackPanel></Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
