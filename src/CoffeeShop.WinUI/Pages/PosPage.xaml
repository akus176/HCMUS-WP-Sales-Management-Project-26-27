<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoffeeShop.WinUI.Pages.PosPage" Background="{StaticResource ConsoleGroundBrush}" FontFamily="{StaticResource ConsoleSansFont}" Foreground="{StaticResource ConsoleInkBrush}" SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <SolidColorBrush x:Key="CounterCardSurfaceBrush" Color="#FBF7EF" />
        <Style x:Key="CustomerSearchTextBox" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0,10,10,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="CounterFlyout" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource ConsoleGroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConsoleRuleBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MaxWidth" Value="360" />
        </Style>
        <Style x:Key="CounterMenuContainer" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
        </Style>
        <Style x:Key="CounterCategory" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleTabStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="15" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Background" Value="{StaticResource ConsoleRaisedGroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Opacity" Value=".75" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Opacity" Value=".4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Background" Value="{StaticResource ConsolePanelBrush}" />
                                            <Setter Target="Chrome.BorderBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" CharacterSpacing="{TemplateBinding CharacterSpacing}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CounterPrimary" TargetType="Button" BasedOn="{StaticResource ConsolePrimaryButtonStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="40" />
        </Style>
        <Style x:Key="CounterButton" TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="CounterDialogCancel" TargetType="Button" BasedOn="{StaticResource CounterButton}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CharacterSpacing" Value="0" />
        </Style>
        <Style x:Key="CounterBody" TargetType="TextBlock" BasedOn="{StaticResource ConsoleBodyStyle}">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="CounterLabel" TargetType="TextBlock" BasedOn="{StaticResource ConsoleLabelStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="70" />
        </Style>
        <DataTemplate x:Key="MenuCardTemplate">
            <Border BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1" Background="{StaticResource CounterCardSurfaceBrush}" CornerRadius="5">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="4,4,0,0">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                        </Border.Background>
                    </Border>
                    <Grid Grid.Row="1" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Padding="10,6,8,6" RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="26" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="{Binding Name}" FontFamily="{StaticResource ConsoleSansMediumFont}"
                                   FontSize="14" LineHeight="17" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                        <TextBlock Grid.Row="1" Text="{Binding Price}" FontFamily="{StaticResource ConsoleSansMediumFont}"
                                   FontSize="13" Foreground="{StaticResource ConsoleAccentTextBrush}" Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center" />
                        <Border Grid.Row="1" Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                                Background="{StaticResource ConsoleRaisedGroundBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1"
                                IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                            <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource ConsoleAccentTextBrush}" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CartLineTemplate">
            <Grid Padding="0,8" RowSpacing="6" ColumnSpacing="12" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource ConsoleInkBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="18" FontFamily="{StaticResource ConsoleSerifFont}" Foreground="{StaticResource ConsoleInkBrush}" Typography.NumeralAlignment="Tabular" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Details}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Width="44" MinWidth="44" Height="44" MinHeight="44" Padding="0" Click="OnDecreaseLine" Tag="{Binding}" AutomationProperties.Name="{Binding DecreaseLabel}" Style="{StaticResource CounterButton}">
                            <FontIcon Glyph="" FontSize="12" />
                        </Button>
                        <TextBlock Text="{Binding Quantity}" MinWidth="24" FontSize="15" VerticalAlignment="Center" TextAlignment="Center" />
                        <Button Width="44" MinWidth="44" Height="44" MinHeight="44" Padding="0" Click="OnIncreaseLine" Tag="{Binding}" AutomationProperties.Name="{Binding IncreaseLabel}" Style="{StaticResource CounterButton}">
                            <FontIcon Glyph="" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding UnitPrice}" FontSize="12" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                    <Button Grid.Column="2" Width="44" MinWidth="44" Height="44" MinHeight="44" Padding="0" Click="OnRemoveLine" Tag="{Binding}" AutomationProperties.Name="{Binding RemoveLabel}" ToolTipService.ToolTip="Remove item" Style="{StaticResource CounterButton}" BorderBrush="Transparent">
                        <FontIcon Glyph="" FontSize="15" />
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SavedLineTemplate">
            <Grid Padding="0,12" ColumnSpacing="10" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Quantity}" FontSize="14" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="18" FontFamily="{StaticResource ConsoleSerifFont}" Typography.NumeralAlignment="Tabular" />
            </Grid>
        </DataTemplate>
        <Style x:Key="ServiceChannelTab" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource ConsoleSansFont}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ConsoleAccentTextBrush}" />
            <Setter Property="FocusVisualMargin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Opacity" Value=".85" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Opacity" Value=".65" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Opacity" Value=".45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" x:Name="PageScroll" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Padding="{StaticResource ConsolePagePadding}" x:Name="PageLayout" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="WorkspaceRow" Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderLayout" MinHeight="0" ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="HeaderActionColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="Counter" Style="{StaticResource ConsolePageTitleStyle}" FontSize="36" LineHeight="42" AutomationProperties.HeadingLevel="Level1" />
                </StackPanel>
                <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="AddTableButton" Content="ADD TABLE" Click="OnAddTable" Style="{StaticResource CounterButton}" MinHeight="48" Visibility="Collapsed" AutomationProperties.Name="Add dining table" />
                    <Button x:Name="NewButton" Click="OnNewTicket" Style="{StaticResource CounterPrimary}" AutomationProperties.Name="Start a new ticket">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="NEW TICKET" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="8">
                <Border Height="1" Background="{StaticResource ConsoleAccentBrush}" />
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Updating menu and ticket" />
                <InfoBar x:Name="Status" IsClosable="False" IsOpen="False" />
            </StackPanel>
            <Grid x:Name="Layout" ColumnSpacing="24" RowSpacing="12" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MenuColumn" Width="*" />
                    <ColumnDefinition x:Name="TicketColumn" Width="350" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" x:Name="MenuRow" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="MenuPanel" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="MenuItemsRow" Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <Border BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="" FontSize="14" Foreground="{StaticResource ConsoleMutedInkBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search the menu" AutomationProperties.Name="Search the menu" MaxLength="120" Style="{StaticResource ConsoleFieldStyle}" KeyDown="OnSearchKeyDown" MinHeight="34" FontSize="13" BorderThickness="0" Background="Transparent" Padding="0,6,8,6" VerticalContentAlignment="Center">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    </TextBox.Resources>
                                </TextBox>
                                <Button x:Name="SearchButton" Grid.Column="2" Content="SEARCH" Click="OnSearch" Style="{StaticResource CounterButton}" MinHeight="34" FontSize="10" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1,0,0,0" VerticalAlignment="Stretch" Padding="14,0" />
                            </Grid>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                            <ItemsControl x:Name="CategoryList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Content="{Binding Label}" IsChecked="{Binding Selected, Mode=OneWay}" Tag="{Binding}" Click="OnCategoryClick" Style="{StaticResource CounterCategory}" Margin="0,0,6,2" Padding="10,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <Grid ColumnSpacing="12" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="MenuHeading" Text="All items" Style="{StaticResource ConsoleSectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock x:Name="MenuCount" Style="{StaticResource CounterLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="ReloadButton" Grid.Column="2" Click="OnReload" Style="{StaticResource ConsoleIconButtonStyle}" AutomationProperties.Name="Refresh menu and ticket" ToolTipService.ToolTip="Refresh menu and ticket">
                            <FontIcon Glyph="" FontSize="16" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="2">
                        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Padding="24,32" Spacing="12" Background="{StaticResource ConsoleRaisedGroundBrush}" VerticalAlignment="Top">
                            <TextBlock Text="No items found" Style="{StaticResource ConsoleSectionTitleStyle}" />
                            <TextBlock x:Name="EmptyText" Text="Try another search or category to find something on the menu." TextWrapping="Wrap" Style="{StaticResource CounterBody}" />
                            <Button x:Name="ClearSearchButton" Content="SHOW ALL ITEMS" Click="OnClearSearch" Style="{StaticResource CounterButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                        <GridView x:Name="MenuGrid" ItemTemplate="{StaticResource MenuCardTemplate}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Available menu items" ItemContainerStyle="{StaticResource CounterMenuContainer}" SizeChanged="OnMenuGridSizeChanged" IsItemClickEnabled="True" ItemClick="OnMenuItemClick" ContainerContentChanging="OnMenuContainerChanging" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemWidth="194" ItemHeight="260" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </Grid>
                </Grid>
                <Border x:Name="TicketPanel" Grid.Column="1" Background="{StaticResource ConsoleGroundBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,10" Background="{StaticResource ConsoleFieldBrush}" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="TicketKickerText" Text="CURRENT TICKET" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource ConsoleOnFieldMutedBrush}" />
                                <TextBlock x:Name="TicketHeading" Text="Your order" FontSize="26" FontFamily="{StaticResource ConsoleSerifFont}" TextWrapping="Wrap" Foreground="{StaticResource ConsoleOnFieldBrush}" AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <TextBlock x:Name="TicketStatusText" Grid.Column="1" Text="NEW" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource ConsoleAccentLightBrush}" />
                        </Grid>
                        <ScrollViewer x:Name="TicketBodyScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                                <InfoBar x:Name="TicketFeedback" IsOpen="False" IsClosable="False" Severity="Error" />
                                <StackPanel x:Name="CustomerRow" Spacing="4" Margin="0,8,0,4" Padding="0,0,0,8">
                                    <TextBlock x:Name="CustomerText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" />
                                    <UserControl x:Name="CustomerOptionsPanel">
                                        <Border x:Name="CustomerSearchFrame" Background="{StaticResource ConsoleRaisedGroundBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="1" CornerRadius="2" Padding="12,0,0,0" GotFocus="OnCustomerSearchFocusChanged" LostFocus="OnCustomerSearchFocusChanged" Tapped="OnCustomerSearchTapped">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource ConsoleMutedInkBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                                <AutoSuggestBox x:Name="CustomerSearchBox" Grid.Column="1" PlaceholderText="Search name or phone" AutomationProperties.Name="Find a customer by name or phone" TextMemberPath="FullName" TextChanged="OnCustomerSearchChanged" SuggestionChosen="OnCustomerSuggestionChosen" QuerySubmitted="OnCustomerQuerySubmitted" TextBoxStyle="{StaticResource CustomerSearchTextBox}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ConsoleInkBrush}" MinHeight="42" FontFamily="{StaticResource ConsoleSansFont}" FontSize="14" MaxSuggestionListHeight="300" UpdateTextOnSelect="False">
                                                    <AutoSuggestBox.Resources>
                                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                                                        <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="ConsoleMutedInkBrush" />
                                                        <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="ConsoleMutedInkBrush" />
                                                        <StaticResource x:Key="TextControlForeground" ResourceKey="ConsoleInkBrush" />
                                                        <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="ConsoleInkBrush" />
                                                        <StaticResource x:Key="AutoSuggestBoxSuggestionsListBackground" ResourceKey="ConsoleGroundBrush" />
                                                        <StaticResource x:Key="AutoSuggestBoxSuggestionsListBorderBrush" ResourceKey="ConsoleRuleBrush" />
                                                    </AutoSuggestBox.Resources>
                                                    <AutoSuggestBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Spacing="3" Padding="0,6">
                                                                <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Phone}" FontSize="13" />
                                                                <TextBlock FontSize="12"><Run Text="{Binding LoyaltyPointsBalance}" /><Run Text=" points" /></TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </AutoSuggestBox.ItemTemplate>
                                                </AutoSuggestBox>
                                            </Grid>
                                        </Border>
                                    </UserControl>
                                    <TextBlock x:Name="CustomerMetaText" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="CustomerSearchHint" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Order items" FontSize="15" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                                    <TextBlock x:Name="CartCountText" Grid.Column="1" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                </Grid>
                                <ItemsControl x:Name="CartList" ItemTemplate="{StaticResource CartLineTemplate}" AutomationProperties.Name="Ticket items" />
                                <ItemsControl x:Name="SavedLinesList" ItemTemplate="{StaticResource SavedLineTemplate}" AutomationProperties.Name="Saved ticket items" Visibility="Collapsed" />
                                <TextBlock x:Name="TicketEmptyText" Text="Your ticket is empty. Choose an item from the menu to begin." FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource ConsoleMutedInkBrush}" Padding="12,24" MinHeight="96" TextAlignment="Center" />
                                <StackPanel x:Name="ServiceSection" Spacing="8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Service type" FontSize="15" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                                    <Border x:Name="ChannelTabsHost" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,0,0,1" Padding="8,4" Background="{StaticResource ConsoleGroundBrush}">
                                        <StackPanel x:Name="ChannelTabs" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" AutomationProperties.Name="Service type">
                                            <RadioButton x:Name="DineInTab" GroupName="CounterServiceChannel" Content="Dine-in" Tag="dine_in" Checked="OnChannelChecked" Style="{StaticResource ServiceChannelTab}" />
                                            <RadioButton x:Name="TakeawayTab" GroupName="CounterServiceChannel" Content="Takeaway" Tag="takeaway" Checked="OnChannelChecked" Style="{StaticResource ServiceChannelTab}" />
                                            <RadioButton x:Name="DeliveryTab" GroupName="CounterServiceChannel" Content="Delivery" Tag="delivery" Checked="OnChannelChecked" Style="{StaticResource ServiceChannelTab}" />
                                        </StackPanel>
                                    </Border>
                                    <UserControl x:Name="TicketEntryPanel">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="ServiceFormHint" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SavedServiceText" FontSize="13" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                            <StackPanel x:Name="TablePanel">
                                                <ComboBox x:Name="TableBox" Header="Table (required)" PlaceholderText="Select an available table" DisplayMemberPath="TableNumber" SelectionChanged="OnTableChanged" HorizontalAlignment="Stretch" MinHeight="40" FontSize="13" AutomationProperties.Name="Available table" />
                                            </StackPanel>
                                            <StackPanel x:Name="DeliveryPanel" Spacing="10" Visibility="Collapsed">
                                                <TextBlock Text="Delivery details" FontSize="14" FontWeight="SemiBold" />
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="RecipientBox" Header="Recipient (required)" AutomationProperties.Name="Delivery recipient" MaxLength="120" FontSize="13" MinHeight="40" />
                                                    <TextBox x:Name="ContactBox" Grid.Column="1" Header="Phone (required)" AutomationProperties.Name="Contact number" MaxLength="30" InputScope="TelephoneNumber" FontSize="13" MinHeight="40" />
                                                </Grid>
                                                <ComboBox x:Name="DeliveryAddressChoice" Header="Delivery address" DisplayMemberPath="DisplayName" SelectionChanged="OnDeliveryAddressChanged" HorizontalAlignment="Stretch" MinHeight="40" FontSize="13" Visibility="Collapsed" />
                                                <TextBlock x:Name="SavedAddressText" Foreground="{StaticResource ConsoleMutedInkBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                                                <TextBox x:Name="AddressBox" Header="Address (required)" AutomationProperties.Name="Order-only delivery address" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" FontSize="13" />
                                            </StackPanel>
                                        </StackPanel>
                                    </UserControl>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Operator" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                        <ComboBox x:Name="OperatorBox" PlaceholderText="Select an operator to save" DisplayMemberPath="FullName" SelectionChanged="OnOperatorChanged" HorizontalAlignment="Stretch" MinHeight="36" FontSize="13" AutomationProperties.Name="Operator" Grid.Column="1" />
                                    </Grid>
                                </StackPanel>
                                <Button x:Name="MoreOptionsButton" Content="Ticket details and options" Click="OnToggleMoreOptions" Style="{StaticResource CounterButton}" BorderBrush="Transparent" Padding="0" MinHeight="40" HorizontalAlignment="Left" />
                                <StackPanel x:Name="MoreOptionsPanel" Spacing="8" Visibility="Collapsed" Margin="0" FocusVisualSecondaryBrush="{StaticResource ConsoleGroundBrush}">
                                    <TextBlock x:Name="TicketIdText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                    <TextBlock x:Name="TicketText" Foreground="{StaticResource ConsoleMutedInkBrush}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" FocusVisualSecondaryBrush="{StaticResource ConsoleGroundBrush}" />
                                    <Expander Header="Reopen saved ticket" FocusVisualSecondaryBrush="{StaticResource ConsoleGroundBrush}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8" Padding="8" FocusVisualSecondaryBrush="{StaticResource ConsoleGroundBrush}">
                                            <TextBox x:Name="OpenIdBox" Header="Order ID" MinHeight="48" FontSize="14" FocusVisualSecondaryBrush="{StaticResource ConsoleGroundBrush}" />
                                            <Button x:Name="OpenButton" Content="OPEN SAVED TICKET" Click="OnOpen" Style="{StaticResource CounterButton}" FocusVisualSecondaryBrush="{StaticResource ConsoleGroundBrush}" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Padding="16,12" Spacing="6" Background="{StaticResource ConsoleRaisedGroundBrush}" BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LoyaltyButton" Content="Redeem points" Style="{StaticResource CounterButton}" HorizontalAlignment="Stretch" FontSize="13" MinHeight="44">
                                    <Button.Flyout>
                                        <Flyout x:Name="LoyaltyFlyout" Placement="Top" FlyoutPresenterStyle="{StaticResource CounterFlyout}">
                                            <StackPanel Spacing="12" Width="290">
                                                <TextBlock Text="Redeem loyalty points" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="LoyaltyHintText" FontSize="14" TextWrapping="Wrap" />
                                                <InfoBar x:Name="LoyaltyFeedback" IsClosable="False" IsOpen="False" Severity="Error" />
                                                <UserControl x:Name="LoyaltyPanel">
                                                    <StackPanel Spacing="12">
                                                        <TextBox x:Name="LoyaltyPointsBox" Header="Points to redeem" PlaceholderText="Enter whole points" MinHeight="44" FontSize="14" InputScope="Number" />
                                                        <Button Content="Apply points" Click="OnRedeemLoyalty" Style="{StaticResource CounterPrimary}" HorizontalAlignment="Stretch" MinHeight="44" />
                                                    </StackPanel>
                                                </UserControl>
                                                <TextBlock Text="Points are earned when a linked, fully paid order is completed." FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="DiscountButton" Grid.Column="1" Content="Add discount" Style="{StaticResource CounterButton}" HorizontalAlignment="Stretch" FontSize="13" MinHeight="44">
                                    <Button.Flyout>
                                        <Flyout x:Name="DiscountFlyout" Placement="Top" FlyoutPresenterStyle="{StaticResource CounterFlyout}">
                                            <StackPanel Spacing="12" Width="290">
                                                <TextBlock Text="Request a discount" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="DiscountHintText" FontSize="14" TextWrapping="Wrap" />
                                                <InfoBar x:Name="DiscountFeedback" IsClosable="False" IsOpen="False" Severity="Error" />
                                                <UserControl x:Name="DiscountPanel">
                                                    <StackPanel Spacing="12">
                                                        <ComboBox x:Name="DiscountTypeBox" Header="Discount type" SelectedIndex="0" MinHeight="44" FontSize="14" HorizontalAlignment="Stretch">
                                                            <ComboBoxItem Content="Fixed amount" Tag="fixed" />
                                                            <ComboBoxItem Content="Percentage" Tag="percentage" />
                                                        </ComboBox>
                                                        <TextBox x:Name="DiscountValueBox" Header="Value" MinHeight="44" FontSize="14" />
                                                        <TextBox x:Name="DiscountReasonBox" Header="Reason" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" FontSize="14" />
                                                        <Button Content="Request approval" Click="OnRequestDiscount" Style="{StaticResource CounterPrimary}" HorizontalAlignment="Stretch" MinHeight="44" />
                                                    </StackPanel>
                                                </UserControl>
                                                <TextBlock Text="A manager approves requests in Service board. Refresh this ticket after approval to update the total." FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="AdjustmentsHintText" FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" />
                            <StackPanel x:Name="TotalsBreakdown" Spacing="6" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Subtotal" FontSize="13" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                    <TextBlock x:Name="SubtotalText" Grid.Column="1" FontSize="14" Typography.NumeralAlignment="Tabular" />
                                </Grid>
                                <Grid x:Name="DiscountTotalRow" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Approved discounts" FontSize="13" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                    <TextBlock x:Name="DiscountTotalText" Grid.Column="1" FontSize="14" />
                                </Grid>
                                <Grid x:Name="LoyaltySavingsRow" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Loyalty savings" FontSize="13" Foreground="{StaticResource ConsoleMutedInkBrush}" />
                                    <TextBlock x:Name="LoyaltySavingsText" Grid.Column="1" FontSize="14" />
                                </Grid>
                            </StackPanel>
                            <Grid BorderBrush="{StaticResource ConsoleRuleBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="TicketTotalLabel" Text="Estimated total" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TotalHintText" Text="Save to review the final total" FontSize="11" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="TicketTotalText" Grid.Column="1" FontSize="32" FontFamily="{StaticResource ConsoleSerifFont}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            </Grid>
                            <Button x:Name="RefreshTicketButton" Content="Refresh ticket to continue" Click="OnReload" Style="{StaticResource CounterButton}" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                            <Button x:Name="SaveButton" Content="Save &amp; review ticket" Click="OnSaveDraft" Style="{StaticResource CounterPrimary}" HorizontalAlignment="Stretch" FontSize="13" ToolTipService.ToolTip="Save a draft, then review its exact total before confirming" />
                            <Button x:Name="ConfirmButton" Content="Confirm order" Click="OnConfirm" Style="{StaticResource CounterPrimary}" HorizontalAlignment="Stretch" FontSize="13" IsEnabled="False" Visibility="Collapsed" />
                            <Button x:Name="ServiceBoardButton" Content="Open Service board" Click="OnServiceBoard" Style="{StaticResource CounterPrimary}" FontSize="13" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                            <TextBlock x:Name="TicketStepText" Text="Add items to start your ticket." FontSize="12" Foreground="{StaticResource ConsoleMutedInkBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <ContentDialog x:Name="CustomizationDialog" PrimaryButtonText="Add to ticket" CloseButtonText="Cancel"
                           PrimaryButtonStyle="{StaticResource CounterPrimary}" CloseButtonStyle="{StaticResource CounterDialogCancel}"
                           DefaultButton="Primary" Opened="OnCustomizationOpened" PrimaryButtonClick="OnCustomizationAdd"
                           MaxWidth="440" Background="{StaticResource ConsoleGroundBrush}" Foreground="{StaticResource ConsoleInkBrush}">
                <ContentDialog.Resources>
                    <StaticResource x:Key="ContentDialogBackground" ResourceKey="ConsoleGroundBrush" />
                    <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ConsoleGroundBrush" />
                    <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="ConsoleRuleBrush" />
                    <StaticResource x:Key="ContentDialogSeparatorBorderBrush" ResourceKey="ConsoleRuleBrush" />
                </ContentDialog.Resources>
                <ContentDialog.Title>
                    <TextBlock x:Name="SelectedDrinkName" FontFamily="{StaticResource ConsoleSerifFont}" FontSize="28" TextWrapping="Wrap" />
                </ContentDialog.Title>
                <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource ConsoleGroundBrush}">
                    <StackPanel Spacing="16" MinWidth="280" MaxWidth="380">
                        <Border Height="160" AutomationProperties.AccessibilityView="Raw">
                            <Border.Background>
                                <ImageBrush x:Name="CustomizationPhoto" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                            </Border.Background>
                        </Border>
                        <InfoBar x:Name="CustomizationError" IsOpen="False" IsClosable="False" Severity="Error" />
                        <UserControl x:Name="EntryPanel">
                            <StackPanel Spacing="8">
                                <ComboBox x:Name="DrinkBox" DisplayMemberPath="Name" SelectionChanged="OnDrinkChanged" Visibility="Collapsed" MinHeight="48" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SizeBox" Header="Size" DisplayMemberPath="SizeName" SelectionChanged="OnSizeChanged" HorizontalAlignment="Stretch" MinHeight="48" />
                                    <TextBox x:Name="QuantityBox" Grid.Column="1" Header="Quantity" Text="1" MaxLength="10" Style="{StaticResource ConsoleFieldStyle}" InputScope="Number" MinHeight="48" FontSize="14" />
                                </Grid>
                                <TextBlock x:Name="SizePriceText" Style="{StaticResource CounterBody}" />
                                <StackPanel x:Name="AddonsPanel" Spacing="4">
                                    <TextBlock Text="OPTIONAL ADD-ONS" Style="{StaticResource CounterLabel}" />
                                    <ListView x:Name="AddonsList" SelectionMode="Multiple" MaxHeight="120" AutomationProperties.Name="Compatible add-ons">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Price}" Foreground="{StaticResource ConsoleAccentTextBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </StackPanel>
                        </UserControl>
                    </StackPanel>
                </ScrollViewer>
            </ContentDialog>
        </Grid>
    </ScrollViewer>
</Page>
