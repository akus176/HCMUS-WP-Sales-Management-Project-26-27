<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">$(DefineConstants);COFFEESHOP_API_ONLY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CoffeeShop.Application\CoffeeShop.Application.csproj" />
    <ProjectReference Include="..\CoffeeShop.Contracts\CoffeeShop.Contracts.csproj" />
    <ProjectReference Include="..\CoffeeShop.Infrastructure.Postgres\CoffeeShop.Infrastructure.Postgres.csproj" Condition="'$(Configuration)' != 'Release'" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="WinUIServiceCollectionExtensions.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\OFL-*.txt" />
    <Content Include="Assets\Ornaments\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Patterns\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Icons\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\IconsLight\*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
